---
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import Logo from '../components/Logo.astro';
import Toaster from '../components/Toaster';

interface Props {
  title: string;
  active?: string;
}
const { title, active } = Astro.props;
const profile = Astro.locals.profile;
const isAdmin = profile?.role === 'admin';

const nav = [
  { href: '/panel', label: 'Inicio', icon: 'heroicons:squares-2x2', key: 'inicio' },
  { href: '/panel/solicitudes', label: 'Solicitudes', icon: 'heroicons:inbox-stack', key: 'solicitudes' },
  { href: '/panel/agenda', label: 'Agenda', icon: 'heroicons:calendar-days', key: 'agenda' },
  ...(isAdmin
    ? [
        { href: '/panel/configuracion', label: 'Configuración', icon: 'heroicons:cog-6-tooth', key: 'configuracion' },
        { href: '/panel/usuarios', label: 'Usuarios', icon: 'heroicons:users', key: 'usuarios' },
      ]
    : []),
];

const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const flash = error ? { type: 'error' as const, message: error } : ok ? { type: 'success' as const, message: ok } : null;
const initials = (profile?.full_name || profile?.email || '?')
  .split(/[\s@]/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]!.toUpperCase())
  .join('');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/panel.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/panel-192.png" />
    <meta name="theme-color" content="#fffaf1" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Llevo Panel" />
    <title>{title} · Panel</title>
  </head>
  <body class="min-h-dvh bg-cream">
    <div class="lg:grid lg:min-h-dvh lg:grid-cols-[260px_1fr]">
      <!-- Barra superior móvil -->
      <header class="sticky top-0 z-30 flex h-16 items-center justify-between border-b border-line bg-cream/90 px-4 backdrop-blur lg:hidden">
        <a href="/panel"><Logo height={30} label="Panel" /></a>
        <button type="button" class="grid size-10 place-items-center rounded-xl bg-paper border border-line" data-menu-btn aria-label="Abrir menú">
          <Icon name="heroicons:bars-3" class="size-5" />
        </button>
      </header>

      <!-- Menú lateral -->
      <aside
        class="fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col overflow-y-auto border-r border-line bg-paper p-4 transition-transform data-[open=true]:translate-x-0 lg:sticky lg:top-0 lg:h-dvh lg:w-auto lg:translate-x-0"
        data-menu
      >
        <div class="flex items-center justify-between px-2 py-2">
          <a href="/panel"><Logo height={30} label="Panel" /></a>
          <a href="/" target="_blank" class="rounded-lg p-2 text-ink-3 hover:bg-sand hover:text-ink" title="Ver la web">
            <Icon name="heroicons:arrow-top-right-on-square" class="size-5" />
          </a>
        </div>

        <nav class="mt-6 flex-1 space-y-1">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  'flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition',
                  active === n.key ? 'bg-ink text-white' : 'text-ink-2 hover:bg-sand hover:text-ink',
                ]}
              >
                <Icon name={n.icon} class="size-5" />
                {n.label}
                {n.key === 'solicitudes' && (
                  <span
                    data-nav-count
                    aria-label="solicitudes nuevas"
                    class="ml-auto hidden min-w-6 rounded-full bg-butter px-1.5 py-0.5 text-center text-xs font-bold text-ink tabular-nums"
                  />
                )}
              </a>
            ))
          }
        </nav>

        <div class="mb-3 grid grid-cols-2 gap-2" aria-label="Avisos">
          <button
            type="button"
            data-push-toggle
            aria-pressed="false"
            class="group flex flex-col items-start gap-1.5 rounded-xl border border-line bg-paper px-3 py-2.5 text-left text-xs font-semibold text-ink-2 transition-colors hover:bg-sand aria-pressed:border-brand-200 aria-pressed:bg-brand-50 aria-pressed:text-brand-700 disabled:opacity-60"
          >
            <Icon name="heroicons:bell-alert" class="hidden size-5 group-aria-pressed:block" />
            <Icon name="heroicons:bell-slash" class="size-5 group-aria-pressed:hidden" />
            <span data-state>Activar avisos</span>
          </button>
          <button
            type="button"
            data-sound-toggle
            aria-pressed="true"
            class="group flex flex-col items-start gap-1.5 rounded-xl border border-line bg-paper px-3 py-2.5 text-left text-xs font-semibold text-ink-2 transition-colors hover:bg-sand aria-pressed:border-brand-200 aria-pressed:bg-brand-50 aria-pressed:text-brand-700"
          >
            <Icon name="heroicons:speaker-wave" class="hidden size-5 group-aria-pressed:block" />
            <Icon name="heroicons:speaker-x-mark" class="size-5 group-aria-pressed:hidden" />
            <span data-state>Sonido activado</span>
          </button>
        </div>
        <button
          type="button"
          data-install
          class="mb-3 hidden w-full items-center gap-3 rounded-xl border border-dashed border-brand-300 bg-brand-50 px-3 py-2.5 text-left text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-100 [&:not(.hidden)]:flex"
        >
          <Icon name="heroicons:device-phone-mobile" class="size-5" />
          <span>Instalar app del panel<span class="block text-xs font-normal text-brand-600">Ábrela desde tu pantalla de inicio</span></span>
        </button>
        <div class="rounded-2xl bg-sand p-3">
          <a href="/panel/cuenta" class="flex items-center gap-3 rounded-xl p-1 transition hover:bg-paper/60">
            <span class="grid size-10 place-items-center rounded-xl bg-brand-500 text-sm font-medium text-white">{initials}</span>
            <span class="min-w-0">
              <span class="block truncate text-sm font-medium">{profile?.full_name || 'Sin nombre'}</span>
              <span class="block truncate text-xs text-ink-2">{isAdmin ? 'Administrador' : 'Equipo'} · {profile?.email}</span>
            </span>
          </a>
          <form method="post" action="/panel/salir" class="mt-2">
            <button class="flex w-full items-center gap-2 rounded-xl px-2 py-2 text-sm font-medium text-ink-2 transition hover:bg-paper/60 hover:text-ink">
              <Icon name="heroicons:arrow-right-on-rectangle" class="size-5" /> Cerrar sesión
            </button>
          </form>
        </div>
      </aside>
      <div class="fixed inset-0 z-30 hidden bg-ink/30 backdrop-blur-sm lg:hidden" data-menu-overlay></div>

      <main class="min-w-0 px-4 py-6 sm:px-8 sm:py-10">
        <div class="mx-auto max-w-6xl">
          <slot />
        </div>
      </main>
    </div>

    <script>
      const menu = document.querySelector<HTMLElement>('[data-menu]')!;
      const overlay = document.querySelector<HTMLElement>('[data-menu-overlay]')!;
      const toggle = (open: boolean) => {
        menu.dataset.open = String(open);
        overlay.classList.toggle('hidden', !open);
      };
      document.querySelector('[data-menu-btn]')?.addEventListener('click', () => toggle(true));
      overlay.addEventListener('click', () => toggle(false));

      // Quita ?ok= / ?error= de la URL para que el aviso no reaparezca al recargar.
      const url = new URL(location.href);
      if (url.searchParams.has('ok') || url.searchParams.has('error')) {
        url.searchParams.delete('ok');
        url.searchParams.delete('error');
        history.replaceState(null, '', url);
      }

      // Confirmación para acciones destructivas.
      document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
        f.addEventListener('submit', (e) => {
          if (!confirm(f.dataset.confirm)) e.preventDefault();
        }),
      );
    </script>
    <Toaster client:load flash={flash} />
    <script>
      import '../scripts/micro';
      import '../scripts/pwa';
      import '../scripts/panel-live';
    </script>
  </body>
</html>
