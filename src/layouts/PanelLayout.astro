---
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import Logo from '../components/Logo.astro';
import Toaster from '../components/Toaster';

interface Props {
  title: string;
  active?: string;
}
const { title, active } = Astro.props;
const profile = Astro.locals.profile;
const isAdmin = profile?.role === 'admin';

const nav = [
  { href: '/panel', label: 'Inicio', icon: 'heroicons:squares-2x2', key: 'inicio' },
  { href: '/panel/solicitudes', label: 'Solicitudes', icon: 'heroicons:inbox-stack', key: 'solicitudes' },
  { href: '/panel/agenda', label: 'Agenda', icon: 'heroicons:calendar-days', key: 'agenda' },
  ...(isAdmin
    ? [
        { href: '/panel/configuracion', label: 'Configuración', icon: 'heroicons:cog-6-tooth', key: 'configuracion' },
        { href: '/panel/usuarios', label: 'Usuarios', icon: 'heroicons:users', key: 'usuarios' },
      ]
    : []),
];

// Pestañas del celular: las 3 secciones diarias + "Más" (abre el menú con el resto)
const tabs = nav.filter((n) => ['inicio', 'solicitudes', 'agenda'].includes(n.key));
const moreActive = !!active && !tabs.some((t) => t.key === active);

// Contador de solicitudes nuevas pintado desde el servidor (antes aparecía tarde y "saltaba")
let nuevas = 0;
try {
  const { count } = (await Astro.locals.supabase?.from('requests').select('id', { count: 'exact', head: true }).eq('status', 'nueva')) ?? {};
  nuevas = count ?? 0;
} catch {
  /* sin conexión: lo completa panel-live */
}
const badge = nuevas > 99 ? '99+' : String(nuevas);

const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const flash = error ? { type: 'error' as const, message: error } : ok ? { type: 'success' as const, message: ok } : null;
const initials = (profile?.full_name || profile?.email || '?')
  .split(/[\s@]/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]!.toUpperCase())
  .join('');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/panel.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/panel-192.png" />
    <meta name="theme-color" content="#fffaf1" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Llevo Panel" />
    <title>{title} · Panel</title>
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "where": { "and": [{ "href_matches": "/panel/*" }, { "not": { "href_matches": "/panel/salir" } }] },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    <script is:inline>
      // Transición compartida lista ⇄ detalle: solo la fila tocada recibe los nombres (deben ser únicos por página)
      (function () {
        var parts = ['name', 'status', 'photo'];
        var tagged = null;
        function tag(row, on) {
          parts.forEach(function (p) {
            var el = row.querySelector('[data-vt="' + p + '"]');
            if (el) el.style.viewTransitionName = on ? 'req-' + p : '';
          });
        }
        // Ida: al tocar una fila
        document.addEventListener('click', function (e) {
          var row = e.target.closest && e.target.closest('[data-vt-row]');
          if (!row) return;
          if (tagged) tag(tagged, false);
          tag(row, true);
          tagged = row;
        }, true);
        // Al volver con "atrás" desde la caché del navegador, limpiar
        window.addEventListener('pageshow', function () {
          if (tagged) { tag(tagged, false); tagged = null; }
        });
        // Promesa que se cumple cuando termina la transición de entrada (o enseguida si no hay):
        // lo pesado (como el mapa) espera a esto para no trabar la animación
        var ready;
        window.__vtReady = new Promise(function (r) { ready = r; });
        // Sin soporte de transiciones (p. ej. Firefox): no hay nada que esperar
        if (!('onpagereveal' in window)) ready();
        setTimeout(function () { ready(); }, 1200);
        window.addEventListener('pagereveal', function (e) {
          if (!e.viewTransition) return ready();
          e.viewTransition.finished.finally(function () { ready(); });
        });
        // Vuelta: llegando desde un detalle, la fila de esa solicitud recibe los nombres
        window.addEventListener('pagereveal', function (e) {
          if (!e.viewTransition || !window.navigation || !navigation.activation || !navigation.activation.from) return;
          var m = /\/panel\/solicitudes\/([0-9a-f-]{36})/.exec(navigation.activation.from.url || '');
          if (!m) return;
          var rows = document.querySelectorAll('[data-vt-row="' + m[1] + '"]');
          var row = null;
          for (var i = 0; i < rows.length; i++) if (rows[i].getClientRects().length) { row = rows[i]; break; }
          if (!row) return;
          tag(row, true);
          e.viewTransition.finished.finally(function () { tag(row, false); });
        });
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-cream">
    <div class="lg:grid lg:min-h-dvh lg:grid-cols-[260px_1fr]">
      <!-- Barra superior móvil -->
      <header class="sticky top-0 z-30 flex h-14 [view-transition-name:panel-top] items-center justify-between border-b border-line bg-cream/90 px-4 backdrop-blur lg:hidden">
        <a href="/panel" class="[view-transition-name:llevo-logo]"><Logo height={34} label="Panel" /></a>
        <a href="/panel/cuenta" class="grid size-9 place-items-center rounded-xl bg-brand-500 text-xs font-semibold text-white" title="Mi cuenta">{initials}</a>
      </header>

      <!-- Menú lateral -->
      <aside
        class="fixed inset-y-0 left-0 z-40 flex w-72 lg:[view-transition-name:panel-side] -translate-x-full flex-col overflow-y-auto border-r border-line bg-paper p-4 transition-transform data-[open=true]:translate-x-0 lg:sticky lg:top-0 lg:h-dvh lg:w-auto lg:translate-x-0"
        data-menu
      >
        <div class="flex items-center justify-between px-2 py-2">
          <a href="/panel" class="lg:[view-transition-name:llevo-logo]"><Logo height={34} label="Panel" /></a>
          <a href="/" target="_blank" class="rounded-lg p-2 text-ink-3 hover:bg-sand hover:text-ink" title="Ver la web">
            <Icon name="heroicons:arrow-top-right-on-square" class="size-5" />
          </a>
        </div>

        <nav class="mt-6 flex-1 space-y-1">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  'flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition',
                  active === n.key ? 'bg-ink text-white' : 'text-ink-2 hover:bg-sand hover:text-ink',
                ]}
              >
                <Icon name={n.icon} class="size-5" />
                {n.label}
                {n.key === 'solicitudes' && (
                  <span
                    data-nav-count
                    aria-label="solicitudes nuevas"
                    class:list={['ml-auto min-w-6 rounded-full bg-butter px-1.5 py-0.5 text-center text-xs font-bold text-ink tabular-nums', !nuevas && 'hidden']}
                  >
                    {badge}
                  </span>
                )}
              </a>
            ))
          }
        </nav>

        <div class="mb-3 grid grid-cols-2 gap-2" aria-label="Avisos">
          <button
            type="button"
            data-push-toggle
            aria-pressed="false"
            class="group flex flex-col items-start gap-1.5 rounded-xl border border-line bg-paper px-3 py-2.5 text-left text-xs font-semibold text-ink-2 transition-colors hover:bg-sand aria-pressed:border-brand-200 aria-pressed:bg-brand-50 aria-pressed:text-brand-700 disabled:opacity-60"
          >
            <Icon name="heroicons:bell-alert" class="hidden size-5 group-aria-pressed:block" />
            <Icon name="heroicons:bell-slash" class="size-5 group-aria-pressed:hidden" />
            <span data-state>Activar avisos</span>
          </button>
          <button
            type="button"
            data-sound-toggle
            aria-pressed="true"
            class="group flex flex-col items-start gap-1.5 rounded-xl border border-line bg-paper px-3 py-2.5 text-left text-xs font-semibold text-ink-2 transition-colors hover:bg-sand aria-pressed:border-brand-200 aria-pressed:bg-brand-50 aria-pressed:text-brand-700"
          >
            <Icon name="heroicons:speaker-wave" class="hidden size-5 group-aria-pressed:block" />
            <Icon name="heroicons:speaker-x-mark" class="size-5 group-aria-pressed:hidden" />
            <span data-state>Sonido activado</span>
          </button>
        </div>
        <button
          type="button"
          data-install
          class="mb-3 hidden w-full items-center gap-3 rounded-xl border border-dashed border-brand-300 bg-brand-50 px-3 py-2.5 text-left text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-100 [&:not(.hidden)]:flex"
        >
          <Icon name="heroicons:device-phone-mobile" class="size-5" />
          <span>Instalar app del panel<span class="block text-xs font-normal text-brand-600">Ábrela desde tu pantalla de inicio</span></span>
        </button>
        <div class="rounded-2xl bg-sand p-3">
          <a href="/panel/cuenta" class="flex items-center gap-3 rounded-xl p-1 transition hover:bg-paper/60">
            <span class="grid size-10 place-items-center rounded-xl bg-brand-500 text-sm font-medium text-white">{initials}</span>
            <span class="min-w-0">
              <span class="block truncate text-sm font-medium">{profile?.full_name || 'Sin nombre'}</span>
              <span class="block truncate text-xs text-ink-2">{isAdmin ? 'Administrador' : 'Equipo'} · {profile?.email}</span>
            </span>
          </a>
          <form method="post" action="/panel/salir" class="mt-2">
            <button class="flex w-full items-center gap-2 rounded-xl px-2 py-2 text-sm font-medium text-ink-2 transition hover:bg-paper/60 hover:text-ink">
              <Icon name="heroicons:arrow-right-on-rectangle" class="size-5" /> Cerrar sesión
            </button>
          </form>
        </div>
      </aside>
      <div class="llevo-overlay fixed inset-0 z-[35] hidden lg:hidden" data-menu-overlay></div>

      <!-- Barra de pestañas (celular): lo más usado a un toque del pulgar -->
      <nav
        class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-paper/95 pb-[env(safe-area-inset-bottom)] backdrop-blur [view-transition-name:panel-tabs] lg:hidden"
        aria-label="Secciones del panel"
      >
        <ul class="mx-auto grid max-w-md grid-cols-4">
          {
            tabs.map((t) => (
              <li>
                <a
                  href={t.href}
                  data-tab={t.key}
                  aria-current={active === t.key ? 'page' : undefined}
                  class:list={[
                    'relative flex flex-col items-center gap-1 px-1 pt-2.5 pb-2 text-[11px] font-semibold transition-colors',
                    active === t.key ? 'text-brand-600' : 'text-ink-3 hover:text-ink',
                  ]}
                >
                  <span class:list={['grid h-7 w-12 place-items-center rounded-full transition-colors', active === t.key && 'bg-brand-50']}>
                    <Icon name={t.icon} class="size-[22px]" />
                  </span>
                  {t.label}
                  {t.key === 'solicitudes' && (
                    <span
                      data-nav-count
                      class:list={['absolute top-1 left-1/2 ml-2 min-w-5 rounded-full bg-butter px-1 text-center text-[10px] leading-5 font-bold text-ink tabular-nums', !nuevas && 'hidden']}
                    >
                      {badge}
                    </span>
                  )}
                </a>
              </li>
            ))
          }
          <li>
            <button
              type="button"
              data-menu-btn
              class:list={[
                'flex w-full flex-col items-center gap-1 px-1 pt-2.5 pb-2 text-[11px] font-semibold transition-colors',
                moreActive ? 'text-brand-600' : 'text-ink-3 hover:text-ink',
              ]}
            >
              <span class:list={['grid h-7 w-12 place-items-center rounded-full', moreActive && 'bg-brand-50']}>
                <Icon name="heroicons:squares-plus" class="size-[22px]" />
              </span>
              Más
            </button>
          </li>
        </ul>
      </nav>

      <main class="min-w-0 px-3 pt-5 pb-[calc(5.5rem+env(safe-area-inset-bottom))] sm:px-8 sm:pt-10 sm:pb-[calc(5.5rem+env(safe-area-inset-bottom))] lg:pb-10">
        <div class="mx-auto max-w-6xl">
          <button
            type="button"
            hidden
            data-push-toggle
            data-push-hint
            class="mb-4 flex w-full items-center gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-left lg:hidden"
          >
            <Icon name="heroicons:bell-alert" class="size-5 shrink-0 text-amber-700" />
            <span class="min-w-0">
              <span data-state class="block text-sm font-semibold text-ink">Este celular no está recibiendo avisos</span>
              <span class="block text-xs font-normal text-ink-2">Toca para activarlos en este teléfono.</span>
            </span>
          </button>
          <slot />
        </div>
      </main>
    </div>

    <script>
      const menu = document.querySelector<HTMLElement>('[data-menu]')!;
      const overlay = document.querySelector<HTMLElement>('[data-menu-overlay]')!;
      const toggle = (open: boolean) => {
        menu.dataset.open = String(open);
        overlay.classList.toggle('hidden', !open);
      };
      document.querySelectorAll('[data-menu-btn]').forEach((b) => b.addEventListener('click', () => toggle(true)));
      overlay.addEventListener('click', () => toggle(false));

      // Quita ?ok= / ?error= de la URL para que el aviso no reaparezca al recargar.
      const url = new URL(location.href);
      if (url.searchParams.has('ok') || url.searchParams.has('error')) {
        url.searchParams.delete('ok');
        url.searchParams.delete('error');
        history.replaceState(null, '', url);
      }

      // Confirmación para acciones destructivas.
      document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
        f.addEventListener('submit', (e) => {
          if (!confirm(f.dataset.confirm)) e.preventDefault();
        }),
      );
    </script>
    <Toaster client:idle flash={flash} />
    <script>
      // Lo que no hace falta para pintar la página arranca cuando termina la transición de entrada
      const after = (window as unknown as { __vtReady?: Promise<void> }).__vtReady ?? Promise.resolve();
      after.then(() => {
        import('../scripts/micro');
        import('../scripts/pwa');
        import('../scripts/panel-live');
      });
    </script>
  </body>
</html>
