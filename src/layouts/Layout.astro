---
import '../styles/global.css';
import type { Business } from '../lib/settings';
import Toaster from '../components/Toaster';

interface Props {
  business: Business;
  title?: string;
  description?: string;
}
const { business, title = `${business.name} · ${business.tagline}`, description = business.description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffaf1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og-image.png', Astro.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        // Seguridad: si el script de animación no carga, el contenido aparece igual.
        setTimeout(function () { document.documentElement.classList.remove('motion'); }, 4000);
      }
    </script>
  </head>
  <body class="min-h-dvh">
    <slot />
    <Toaster client:load />
    <script>
      import '../scripts/motion';
      import '../scripts/micro';
    </script>
  </body>
</html>
