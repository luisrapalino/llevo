---
import { Icon } from 'astro-icon/components';
import PanelLayout from '../../layouts/PanelLayout.astro';

const db = Astro.locals.supabase!;
const me = Astro.locals.profile!;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'name') {
    const { error } = await db.from('profiles').update({ full_name: String(form.get('full_name') ?? '').trim() }).eq('id', me.id);
    return Astro.redirect(`/panel/cuenta?${error ? `error=${encodeURIComponent(error.message)}` : 'ok=Nombre%20actualizado'}`);
  }
  const password = String(form.get('password') ?? '');
  if (password.length < 8 || password !== form.get('confirm')) {
    return Astro.redirect('/panel/cuenta?error=Las%20contrase%C3%B1as%20no%20coinciden%20o%20tienen%20menos%20de%208%20caracteres');
  }
  const { error } = await db.auth.updateUser({ password });
  return Astro.redirect(`/panel/cuenta?${error ? `error=${encodeURIComponent(error.message)}` : 'ok=Contrase%C3%B1a%20actualizada'}`);
}
---

<PanelLayout title="Mi cuenta">
  <h1 class="text-3xl font-medium tracking-[-0.02em] tracking-tight">Mi cuenta</h1>
  <p class="mt-1 text-sm text-ink-2">{me.email} · {me.role === 'admin' ? 'Administrador' : 'Equipo'}</p>

  <div class="mt-8 grid max-w-3xl gap-6 md:grid-cols-2">
    <form method="post" class="space-y-4 rounded-2xl bg-paper p-4 border border-line sm:p-6">
      <input type="hidden" name="action" value="name" />
      <h2 class="flex items-center gap-2 text-lg font-medium"><Icon name="heroicons:user" class="size-5 text-brand-600" /> Tu nombre</h2>
      <input name="full_name" class="field" value={me.full_name} required />
      <button class="btn-dark w-full">Guardar</button>
    </form>

    <form method="post" class="space-y-4 rounded-2xl bg-paper p-4 border border-line sm:p-6">
      <input type="hidden" name="action" value="password" />
      <h2 class="flex items-center gap-2 text-lg font-medium"><Icon name="heroicons:key" class="size-5 text-brand-600" /> Cambiar contraseña</h2>
      <input name="password" type="password" minlength="8" required class="field" placeholder="Nueva contraseña" autocomplete="new-password" />
      <input name="confirm" type="password" minlength="8" required class="field" placeholder="Repítela" autocomplete="new-password" />
      <button class="btn-dark w-full">Actualizar</button>
    </form>
  </div>
</PanelLayout>
