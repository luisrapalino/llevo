---
import { Icon } from 'astro-icon/components';
import PanelLayout from '../../../layouts/PanelLayout.astro';
import StatusBadge from '../../../components/panel/StatusBadge.astro';
import { STATUSES, STATUS_KEYS, TIME_SLOTS, type Status } from '../../../lib/constants';
import { fmtDate, fmtDateTime, shortSlot } from '../../../lib/format';
import { formatCOP, getSettings, normalizePhone, whatsappLink } from '../../../lib/settings';
import { createAdminClient, PHOTOS_BUCKET } from '../../../lib/supabase';
import { photoUrl, thumbPath } from '../../../lib/thumbs';

const db = Astro.locals.supabase!;
const { id } = Astro.params;
const self = `/panel/solicitudes/${id}`;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');

  if (action === 'delete') {
    const { data: row } = await db.from('requests').select('photos').eq('id', id!).single();
    const { error } = await db.from('requests').delete().eq('id', id!);
    if (error) return Astro.redirect(`${self}?error=${encodeURIComponent('No se pudo eliminar.')}`);
    if (row?.photos?.length) await createAdminClient()?.storage.from(PHOTOS_BUCKET).remove([...row.photos, thumbPath(id!)]);
    return Astro.redirect('/panel/solicitudes?ok=Solicitud%20eliminada');
  }

  const status = String(form.get('status')) as Status;
  const price = String(form.get('quoted_price') ?? '').replace(/\D/g, '');
  const update = {
    status: STATUS_KEYS.includes(status) ? status : undefined,
    quoted_price: price ? Number(price) : null,
    internal_notes: String(form.get('internal_notes') ?? '').trim() || null,
    assigned_to: String(form.get('assigned_to') ?? '') || null,
    service_date: /^\d{4}-\d{2}-\d{2}$/.test(String(form.get('service_date'))) ? String(form.get('service_date')) : undefined,
    time_slot: TIME_SLOTS.some((t) => t.value === form.get('time_slot')) ? String(form.get('time_slot')) : undefined,
    exact_time: /^\d{2}:\d{2}/.test(String(form.get('exact_time'))) ? String(form.get('exact_time')) : null,
  };
  const { error } = await db.from('requests').update(update).eq('id', id!);
  return Astro.redirect(error ? `${self}?error=${encodeURIComponent('No se pudo guardar: ' + error.message)}` : `${self}?ok=Cambios%20guardados`);
}

const [{ data: r }, { data: team }, settings] = await Promise.all([
  db.from('requests').select('*').eq('id', id!).maybeSingle(),
  db.from('profiles').select('id, full_name, email').order('full_name'),
  getSettings(db),
]);
if (!r) return Astro.redirect('/panel/solicitudes?error=No%20encontramos%20esa%20solicitud');

// Direcciones estables: el navegador reutiliza las fotos ya descargadas entre visitas
const photos: { path: string; url: string }[] = r.photos.map((path: string) => ({ path, url: photoUrl(path) }));

const biz = settings.business;
const firstName = r.customer_name.split(' ')[0];
const when = `${fmtDate(r.service_date, { weekday: 'long', day: 'numeric', month: 'long' })} (${shortSlot(r.time_slot).toLowerCase()}${r.exact_time ? `, ${r.exact_time.slice(0, 5)}` : ''})`;
const price = r.quoted_price ?? r.estimated_price;
const customerWa = normalizePhone(r.customer_phone, biz.countryCode);

const messages = [
  {
    label: 'Enviar cotización',
    icon: 'heroicons:currency-dollar',
    text: `¡Hola ${firstName}! Te saluda ${biz.name} 🚚\n\nPara tu ${r.service.toLowerCase()} del ${when}, de ${r.origin_address} a ${r.destination_address}, el valor es *${formatCOP(price)}*.\n\n¿Te lo agendamos?`,
  },
  {
    label: 'Confirmar agenda',
    icon: 'heroicons:calendar-days',
    text: `¡Listo ${firstName}! Quedó agendado tu servicio para el ${when}. Te escribimos cuando vayamos en camino. Gracias por elegir ${biz.name} 🙌`,
  },
  {
    label: 'Vamos en camino',
    icon: 'heroicons:truck',
    text: `¡Hola ${firstName}! Vamos en camino a ${r.origin_address}. Llegamos en aproximadamente 20 minutos 🚚`,
  },
  {
    label: 'Pedir más fotos',
    icon: 'heroicons:camera',
    text: `¡Hola ${firstName}! Te saluda ${biz.name}. Para darte un precio exacto, ¿nos podrías enviar fotos de lo que vamos a llevar?`,
  },
];

const coords = (link?: string | null) => /q=(-?[\d.]+,-?[\d.]+)/.exec(link ?? '')?.[1] ?? null;
const originCoords = coords(r.origin_location);
const destinationCoords = coords(r.destination_location);
const mapsDir = `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(originCoords ?? `${r.origin_address} ${r.origin_reference ?? ''}, Valledupar`)}&destination=${encodeURIComponent(destinationCoords ?? `${r.destination_address} ${r.destination_reference ?? ''}, Valledupar`)}&travelmode=driving`;
const floorText = (floor: string | null, elevator: boolean) =>
  !floor || floor === 'Primer piso' ? 'Primer piso' : `Piso ${floor} · ${elevator ? 'con ascensor' : 'sin ascensor'}`;
---

<PanelLayout title={`Solicitud ${r.code}`} active="solicitudes">
  <a href="/panel/solicitudes" class="inline-flex items-center gap-1 text-sm font-medium text-ink-2 hover:text-ink">
    <Icon name="heroicons:arrow-left" class="size-4" /> Solicitudes
  </a>

  <div class="mt-4 flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <!-- Elementos compartidos con la fila de la lista (transición entre páginas) -->
        <h1 class="text-2xl font-medium tracking-[-0.02em] [view-transition-name:req-name] sm:text-3xl">{r.customer_name}</h1>
        <StatusBadge status={r.status} style="view-transition-name: req-status" />
      </div>
      <p class="mt-1 text-sm text-ink-2">
        <span class="font-mono">#{r.code}</span> · {r.service} · recibida {fmtDateTime(r.created_at)}
      </p>
    </div>
    <div class="hidden flex-wrap gap-2 sm:flex">
      <a href={`tel:${r.customer_phone.replace(/[^\d+]/g, '')}`} class="btn-ghost !py-2.5">
        <Icon name="heroicons:phone" class="size-4" /> Llamar
      </a>
      <a href={whatsappLink(customerWa, `¡Hola ${firstName}! Te saluda ${biz.name}.`)} target="_blank" rel="noopener" class="btn !bg-[#25D366] !py-2.5 text-white hover:!bg-[#1fb757]">
        <Icon name="heroicons:chat-bubble-left-right" class="size-4" /> WhatsApp
      </a>
    </div>
  </div>

  <div class="mt-5 grid gap-4 sm:mt-8 sm:gap-6 lg:grid-cols-[1fr_360px]">
    <!-- Columna principal -->
    <div class="space-y-4 sm:space-y-6">
      <!-- Ruta -->
      <section class="rounded-2xl bg-paper p-4 border border-line sm:p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-medium">Ruta</h2>
          <a href={mapsDir} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:text-brand-700">
            <Icon name="heroicons:map" class="size-4" /> Ver en Google Maps
          </a>
        </div>
        <div class="mt-5 grid grid-cols-[auto_1fr] gap-x-4">
          <div class="flex flex-col items-center">
            <span class="grid size-8 place-items-center rounded-full bg-sand"><span class="size-3.5 rounded-full border-[3px] border-ink bg-paper"></span></span>
            <span class="my-1 w-px flex-1 border-l-2 border-dashed border-line"></span>
            <span class="grid size-8 place-items-center rounded-full bg-brand-500 text-white"><Icon name="heroicons:flag-solid" class="size-4" /></span>
          </div>
          <div class="space-y-6">
            <div>
              <p class="text-xs text-ink-3">Recogida</p>
              <p class="font-medium">{r.origin_address}</p>
              {r.origin_reference && <p class="text-sm text-ink-2">{r.origin_reference}</p>}
              <p class="text-xs text-ink-2">{floorText(r.origin_floor, r.origin_elevator)}</p>
              {
                r.origin_location && (
                  <a href={r.origin_location} target="_blank" rel="noopener" class="mt-1 inline-flex items-center gap-1 text-xs font-medium text-brand-600">
                    <Icon name="heroicons:map-pin" class="size-3.5" /> Ubicación marcada por el cliente
                  </a>
                )
              }
            </div>
            <div>
              <p class="text-xs text-ink-3">Entrega</p>
              <p class="font-medium">{r.destination_address}</p>
              {r.destination_reference && <p class="text-sm text-ink-2">{r.destination_reference}</p>}
              <p class="text-xs text-ink-2">{floorText(r.destination_floor, r.destination_elevator)}</p>
              {
                r.destination_location && (
                  <a href={r.destination_location} target="_blank" rel="noopener" class="mt-1 inline-flex items-center gap-1 text-xs font-medium text-brand-600">
                    <Icon name="heroicons:map-pin" class="size-3.5" /> Ubicación marcada en el mapa
                  </a>
                )
              }
            </div>
          </div>
        </div>
        {
          (originCoords || destinationCoords) && (
            <div
              class="mt-5 h-64 overflow-hidden rounded-xl border border-line bg-cream"
              data-panel-map
              data-origin={originCoords ?? ''}
              data-destination={destinationCoords ?? ''}
            />
          )
        }
      </section>

      <!-- Carga -->
      <section class="rounded-2xl bg-paper p-4 border border-line sm:p-6">
        <h2 class="text-lg font-medium">Carga</h2>
        <p class="mt-1 text-sm text-ink-2">{r.load_size}</p>

        {
          photos.length > 0 && (
            <ul class="mt-4 grid grid-cols-3 gap-2 sm:grid-cols-4">
              {photos.map((p, i) => (
                <li>
                  <button
                    type="button"
                    data-photo={p.url}
                    class="group block aspect-square w-full overflow-hidden rounded-2xl bg-sand border border-line"
                    style={i === 0 ? 'view-transition-name: req-photo' : undefined}
                  >
                    <img src={p.url} alt={`Foto ${i + 1}`} loading="lazy" class="size-full object-cover transition" />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
        {
          r.photos.length > 0 && photos.length < r.photos.length && (
            <p class="mt-2 text-xs text-amber-700">{r.photos.length - photos.length} foto(s) no se subieron completamente.</p>
          )
        }

        <p class="mt-5 rounded-2xl bg-sand/60 p-4 text-[15px] leading-relaxed whitespace-pre-line">{r.description}</p>

        {
          r.items.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {r.items.map((it: string) => (
                <span class="rounded-full bg-sand px-3 py-1 text-sm">{it}</span>
              ))}
            </div>
          )
        }

        <dl class="mt-5 grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
          <div class="rounded-2xl bg-sand/60 p-3">
            <dt class="text-xs text-ink-2">Ayudantes extra</dt>
            <dd class="font-medium">{r.helpers}</dd>
          </div>
          <div class="rounded-2xl bg-sand/60 p-3">
            <dt class="text-xs text-ink-2">Desarme / armado</dt>
            <dd class="font-medium">{r.extras.includes('Desarme y armado') ? 'Sí' : 'No'}</dd>
          </div>
          <div class="rounded-2xl bg-sand/60 p-3">
            <dt class="text-xs text-ink-2">Embalaje</dt>
            <dd class="font-medium">{r.extras.includes('Material de embalaje') ? 'Sí' : 'No'}</dd>
          </div>
        </dl>
      </section>

      <!-- Cliente -->
      <section class="rounded-2xl bg-paper p-4 border border-line sm:p-6">
        <h2 class="text-lg font-medium">Cliente</h2>
        <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2">
          <div><dt class="text-xs text-ink-2">Celular</dt><dd class="font-medium">{r.customer_phone}</dd></div>
          <div><dt class="text-xs text-ink-2">Correo</dt><dd class="font-medium">{r.customer_email ?? '—'}</dd></div>
          <div><dt class="text-xs text-ink-2">Prefiere</dt><dd class="font-medium">{r.contact_preference ?? 'WhatsApp'}</dd></div>
          <div><dt class="text-xs text-ink-2">Flexibilidad</dt><dd class="font-medium">{r.flexible ? 'Sí, es flexible' : 'No'}</dd></div>
          {
            r.customer_notes && (
              <div class="sm:col-span-2">
                <dt class="text-xs text-ink-2">Notas del cliente</dt>
                <dd class="whitespace-pre-line">{r.customer_notes}</dd>
              </div>
            )
          }
        </dl>
      </section>
    </div>

    <!-- Columna lateral: gestión -->
    <aside class="space-y-4 sm:space-y-6">
      <form method="post" id="gestion" class="scroll-mt-20 space-y-5 rounded-2xl bg-paper p-4 border border-line sm:p-6 lg:sticky lg:top-6">
        <input type="hidden" name="action" value="update" />
        <h2 class="text-lg font-medium">Gestión</h2>

        <div>
          <span class="field-label">Estado</span>
          <div class="grid grid-cols-2 gap-2">
            {
              STATUS_KEYS.map((s) => (
                <label class="chip justify-center">
                  <input type="radio" name="status" value={s} class="sr-only" checked={r.status === s} />
                  <span class:list={['size-2 rounded-full', STATUSES[s].dot]} />
                  {STATUSES[s].label}
                </label>
              ))
            }
          </div>
        </div>

        <div>
          <label for="quoted_price" class="field-label">Precio cotizado (COP)</label>
          <input
            id="quoted_price"
            name="quoted_price"
            inputmode="numeric"
            class="field font-medium"
            value={r.quoted_price ?? ''}
            placeholder={r.estimated_price ? `Estimado: ${r.estimated_price}` : 'Ej. 150000'}
          />
          {r.estimated_price && <p class="mt-1 text-xs text-ink-2">Estimado automático: {formatCOP(r.estimated_price)}</p>}
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="col-span-2">
            <label for="service_date" class="field-label">Fecha</label>
            <input id="service_date" name="service_date" type="date" class="field" value={r.service_date} />
          </div>
          <div>
            <label for="time_slot" class="field-label">Franja</label>
            <select id="time_slot" name="time_slot" class="field">
              {TIME_SLOTS.map((t) => <option value={t.value} selected={r.time_slot === t.value}>{t.short}</option>)}
            </select>
          </div>
          <div>
            <label for="exact_time" class="field-label">Hora</label>
            <input id="exact_time" name="exact_time" type="time" class="field" value={r.exact_time?.slice(0, 5) ?? ''} />
          </div>
        </div>

        <div>
          <label for="assigned_to" class="field-label">Responsable</label>
          <select id="assigned_to" name="assigned_to" class="field">
            <option value="">Sin asignar</option>
            {(team ?? []).map((t) => <option value={t.id} selected={r.assigned_to === t.id}>{t.full_name || t.email}</option>)}
          </select>
        </div>

        <div>
          <label for="internal_notes" class="field-label">Notas internas</label>
          <textarea id="internal_notes" name="internal_notes" rows="3" class="field resize-none" placeholder="Solo las ve el equipo">{r.internal_notes ?? ''}</textarea>
        </div>

        <button class="btn-primary w-full">
          <Icon name="heroicons:check" class="size-4" /> Guardar cambios
        </button>
        <p class="text-center text-xs text-ink-3">Última actualización {fmtDateTime(r.updated_at)}</p>
      </form>

      <section class="rounded-2xl bg-paper p-4 border border-line sm:p-6">
        <h2 class="text-lg font-medium">Mensajes rápidos</h2>
        <p class="mt-1 text-xs text-ink-2">Abren WhatsApp con el mensaje listo para el cliente.</p>
        <div class="mt-4 space-y-2">
          {
            messages.map((m) => (
              <a
                href={whatsappLink(customerWa, m.text)}
                target="_blank"
                rel="noopener"
                class="flex items-center gap-3 rounded-2xl bg-sand/60 px-4 py-3 text-sm font-medium transition hover:bg-brand-50 hover:text-brand-700"
              >
                <Icon name={m.icon} class="size-5 text-brand-600" />
                {m.label}
                <Icon name="heroicons:arrow-up-right" class="ml-auto size-4 text-ink-3" />
              </a>
            ))
          }
        </div>
      </section>

      <form method="post" data-confirm="¿Eliminar esta solicitud y sus fotos? No se puede deshacer.">
        <input type="hidden" name="action" value="delete" />
        <button class="flex w-full items-center justify-center gap-2 rounded-2xl px-4 py-3 text-sm font-medium text-red-600 transition hover:bg-red-50">
          <Icon name="heroicons:trash" class="size-4" /> Eliminar solicitud
        </button>
      </form>
    </aside>
  </div>

  <!-- Acciones rápidas (celular): un botón redondo que despliega la pastilla con animación -->
  <div class="fixed right-3 bottom-[calc(4.75rem+env(safe-area-inset-bottom))] z-20 flex items-center gap-2 sm:hidden" data-quick>
    <div
      class="hidden origin-right items-center gap-1.5 rounded-full border border-line bg-paper/95 p-1.5 shadow-[0_8px_24px_rgba(20,33,61,0.18)] backdrop-blur"
      id="acciones-rapidas"
      data-quick-menu
    >
      <a href={`tel:${r.customer_phone.replace(/[^\d+]/g, '')}`} class="grid size-10 place-items-center rounded-full bg-sand text-ink" aria-label="Llamar" title="Llamar" data-quick-item>
        <Icon name="heroicons:phone" class="size-5" />
      </a>
      <a href={whatsappLink(customerWa, `¡Hola ${firstName}! Te saluda ${biz.name}.`)} target="_blank" rel="noopener" class="grid size-10 place-items-center rounded-full bg-[#25D366] text-white" aria-label="WhatsApp" title="WhatsApp" data-quick-item>
        <Icon name="heroicons:chat-bubble-left-right" class="size-5" />
      </a>
      <a href="#gestion" class="flex h-10 items-center gap-1.5 rounded-full bg-ink pr-4 pl-3 text-sm font-semibold text-white" data-quick-item>
        <Icon name="heroicons:pencil-square" class="size-5" /> Gestionar
      </a>
    </div>
    <button
      type="button"
      class="grid size-12 shrink-0 place-items-center rounded-full bg-brand-500 text-white shadow-[0_8px_24px_rgba(47,91,234,0.35)]"
      aria-expanded="false"
      aria-controls="acciones-rapidas"
      aria-label="Acciones rápidas"
      data-quick-toggle
    >
      <Icon name="heroicons:plus" class="size-6" data-quick-icon />
    </button>
  </div>

  <script>
    import { animate } from 'motion';
    // Acciones rápidas: el botón despliega la pastilla (resorte) y la vuelve a guardar
    const quick = document.querySelector<HTMLElement>('[data-quick]');
    if (quick) {
      const btn = quick.querySelector<HTMLButtonElement>('[data-quick-toggle]')!;
      const menu = quick.querySelector<HTMLElement>('[data-quick-menu]')!;
      const icon = quick.querySelector<SVGElement>('[data-quick-icon]')!;
      const items = Array.from(menu.querySelectorAll<HTMLElement>('[data-quick-item]'));
      const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const spring = { type: 'spring', stiffness: 520, damping: 32 } as const;
      let open = false;

      const set = (on: boolean) => {
        if (on === open) return;
        open = on;
        btn.setAttribute('aria-expanded', String(on));
        const d = reduce() ? { duration: 0 } : spring;
        animate(icon, { rotate: on ? 135 : 0 }, d);
        if (on) {
          menu.classList.replace('hidden', 'flex');
          animate(menu, { opacity: [0, 1], scaleX: [0.4, 1], x: [16, 0] }, d);
          // los botones aparecen de derecha a izquierda, uno tras otro
          items.forEach((el, i) =>
            animate(el, { opacity: [0, 1], scale: [0.6, 1] }, reduce() ? { duration: 0 } : { ...spring, delay: (items.length - 1 - i) * 0.04 }),
          );
        } else {
          animate(menu, { opacity: 0, scaleX: 0.4, x: 16 }, reduce() ? { duration: 0 } : { duration: 0.16, ease: 'easeIn' }).then(() => {
            if (!open) menu.classList.replace('flex', 'hidden');
          });
        }
      };

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        set(!open);
      });
      // Se guarda al tocar fuera, al elegir una acción o con Esc
      document.addEventListener('click', (e) => open && !quick.contains(e.target as Node) && set(false));
      items.forEach((el) => el.addEventListener('click', () => set(false)));
      document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
    }
  </script>

  <!-- Visor de fotos -->
  <dialog class="m-auto max-h-[90dvh] max-w-[95vw] overflow-visible rounded-2xl bg-transparent p-0 backdrop:bg-ink/85" data-viewer>
    <img alt="Foto ampliada" class="max-h-[85dvh] max-w-[95vw] rounded-2xl object-contain" data-viewer-img />
    <form method="dialog">
      <button class="absolute -top-3 -right-3 grid size-10 place-items-center rounded-full bg-paper text-ink shadow-lg transition-[opacity,scale] duration-200 ease-out data-[hide=true]:scale-75 data-[hide=true]:opacity-0" aria-label="Cerrar" data-viewer-close>
        <Icon name="heroicons:x-mark" class="size-5" />
      </button>
    </form>
  </dialog>
</PanelLayout>

<script>
  // Visor de fotos: la miniatura crece hasta la foto grande y al cerrar vuelve a su lugar
  const viewer = document.querySelector<HTMLDialogElement>('[data-viewer]');
  const img = document.querySelector<HTMLImageElement>('[data-viewer-img]');
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canAnimate = () => 'startViewTransition' in document && !reduce();
  let current: HTMLImageElement | null = null;
  // La X aparece cuando la foto ya terminó de crecer, y se va antes de que se encoja
  const closeBtn = viewer?.querySelector<HTMLElement>('[data-viewer-close]');
  const showX = (on: boolean) => closeBtn?.setAttribute('data-hide', String(!on));

  async function openPhoto(btn: HTMLButtonElement) {
    if (!viewer || !img) return;
    const thumb = btn.querySelector('img')!;
    current = thumb;
    const show = async () => {
      img.src = btn.dataset.photo!;
      await img.decode().catch(() => {});
      viewer.showModal();
    };
    if (!canAnimate()) {
      showX(true);
      return show();
    }
    showX(false);
    const html = document.documentElement;
    html.classList.add('vt-foto');
    thumb.classList.add('vt-foto-src');
    thumb.style.viewTransitionName = 'foto';
    const t = document.startViewTransition(async () => {
      thumb.style.viewTransitionName = '';
      img.style.viewTransitionName = 'foto';
      await show();
    });
    await t.finished.catch(() => {});
    img.style.viewTransitionName = '';
    thumb.classList.remove('vt-foto-src');
    html.classList.remove('vt-foto');
    showX(true);
  }

  async function closePhoto() {
    if (!viewer?.open || !img) return;
    if (!canAnimate() || !current) return viewer.close();
    showX(false);
    await new Promise((r) => setTimeout(r, 120)); // que la X alcance a irse
    const html = document.documentElement;
    const thumb = current;
    html.classList.add('vt-foto');
    thumb.classList.add('vt-foto-src');
    img.style.viewTransitionName = 'foto';
    const t = document.startViewTransition(() => {
      img.style.viewTransitionName = '';
      viewer.close();
      thumb.style.viewTransitionName = 'foto';
    });
    await t.finished.catch(() => {});
    thumb.style.viewTransitionName = '';
    thumb.classList.remove('vt-foto-src');
    html.classList.remove('vt-foto');
  }

  document.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach((b) => b.addEventListener('click', () => openPhoto(b)));
  viewer?.addEventListener('click', (e) => e.target === viewer && closePhoto());
  viewer?.addEventListener('cancel', (e) => {
    e.preventDefault(); // Esc: cerrar con la misma animación
    closePhoto();
  });
  viewer?.querySelector('form[method="dialog"]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    closePhoto();
  });
</script>

<script>
  // Mapa de solo lectura con los puntos que marcó el cliente
  const el = document.querySelector<HTMLElement>('[data-panel-map]');
  if (el) {
    const parse = (v?: string) => {
      const [lat, lng] = (v ?? '').split(',').map(Number);
      return Number.isFinite(lat) && Number.isFinite(lng) && v ? { lat, lng } : null;
    };
    // El mapa (pesado) se carga cuando termina la transición de entrada, para que no se trabe
    ((window as unknown as { __vtReady?: Promise<void> }).__vtReady ?? Promise.resolve())
      .then(() => import('../../../lib/map'))
      .then(async ({ createRouteMap }) => {
      const route = await createRouteMap(el, { interactive: true, draggable: false });
      const o = parse(el.dataset.origin);
      const d = parse(el.dataset.destination);
      if (o) route.set('origen', o, { fly: !d });
      if (d) route.set('destino', d);
    });
  }
</script>
