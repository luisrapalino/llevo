---
import { Icon } from 'astro-icon/components';
import PanelLayout from '../../layouts/PanelLayout.astro';
import StatusBadge from '../../components/panel/StatusBadge.astro';
import RequestThumb from '../../components/panel/RequestThumb.astro';
import { thumbUrls } from '../../lib/thumbs';
import { STATUSES, STATUS_KEYS, type Status } from '../../lib/constants';
import { addDays, fmtDate, shortSlot, timeAgo, todayISO } from '../../lib/format';
import { formatCOP } from '../../lib/settings';

const db = Astro.locals.supabase!;
const today = todayISO();
const in7 = addDays(today, 7);

const monthStart = `${today.slice(0, 7)}-01`;
const prevMonthStart = new Date(Date.UTC(Number(today.slice(0, 4)), Number(today.slice(5, 7)) - 2, 1)).toISOString().slice(0, 10);

const [counts, upcoming, latest, revenue, prevRevenue] = await Promise.all([
  Promise.all(
    STATUS_KEYS.map(async (s) => {
      const { count } = await db.from('requests').select('id', { count: 'exact', head: true }).eq('status', s);
      return [s, count ?? 0] as const;
    }),
  ),
  db
    .from('requests')
    .select('id, code, customer_name, service, service_date, time_slot, status, origin_address, destination_address')
    .in('status', ['agendada', 'cotizada', 'nueva'])
    .gte('service_date', today)
    .lte('service_date', in7)
    .order('service_date')
    .limit(8),
  db
    .from('requests')
    .select('id, code, customer_name, service, created_at, status, photos, estimated_price')
    .eq('status', 'nueva')
    .order('created_at', { ascending: false })
    .limit(6),
  db
    .from('requests')
    .select('quoted_price')
    .eq('status', 'completada')
    .gte('service_date', monthStart)
    .lte('service_date', today),
  db
    .from('requests')
    .select('quoted_price')
    .eq('status', 'completada')
    .gte('service_date', prevMonthStart)
    .lt('service_date', monthStart),
]);

const byStatus = Object.fromEntries(counts) as Record<Status, number>;
const sum = (rows: { quoted_price: number | null }[] | null) => (rows ?? []).reduce((a, r) => a + (r.quoted_price ?? 0), 0);
const monthRevenue = sum(revenue.data);
const prevMonthRevenue = sum(prevRevenue.data);
const revenueDelta = monthRevenue - prevMonthRevenue;

const thumbs = thumbUrls(latest.data ?? []);
const firstName = (Astro.locals.profile?.full_name || Astro.locals.profile?.email || '').split(/[\s@]/)[0];

const delta =
  monthRevenue === 0 && prevMonthRevenue === 0
    ? { text: 'Todavía sin cobros', tone: 'text-ink-3' }
    : revenueDelta === 0
      ? { text: 'Igual que el mes pasado', tone: 'text-ink-3' }
      : revenueDelta > 0
        ? { text: `+${formatCOP(revenueDelta)} frente al mes pasado`, tone: 'text-emerald-700' }
        : { text: `${formatCOP(Math.abs(revenueDelta))} menos que el mes pasado`, tone: 'text-red-700' };

const stats = [
  {
    label: 'Nuevas',
    count: byStatus.nueva,
    value: String(byStatus.nueva),
    meta: 'Por revisar',
    metaTone: 'text-sky-700/80',
    href: '/panel/solicitudes?estado=nueva',
    icon: STATUSES.nueva.icon,
    iconWrap: STATUSES.nueva.iconWrap,
    card: 'border-sky-200 bg-sky-50/80 hover:bg-sky-50',
  },
  {
    label: 'Por confirmar',
    count: byStatus.cotizada,
    value: String(byStatus.cotizada),
    meta: 'Esperando respuesta',
    metaTone: 'text-amber-800/80',
    href: '/panel/solicitudes?estado=cotizada',
    icon: STATUSES.cotizada.icon,
    iconWrap: STATUSES.cotizada.iconWrap,
    card: 'border-amber-200 bg-amber-50/80 hover:bg-amber-50',
  },
  {
    label: 'Agendadas',
    count: byStatus.agendada,
    value: String(byStatus.agendada),
    meta: 'Servicios pendientes',
    metaTone: 'text-violet-800/80',
    href: '/panel/solicitudes?estado=agendada',
    icon: STATUSES.agendada.icon,
    iconWrap: STATUSES.agendada.iconWrap,
    card: 'border-violet-200 bg-violet-50/80 hover:bg-violet-50',
  },
  {
    label: 'Ingresos del mes',
    count: monthRevenue,
    money: true,
    value: formatCOP(monthRevenue),
    meta: delta.text,
    metaTone: delta.tone,
    href: '/panel/solicitudes?estado=completada',
    icon: 'heroicons:banknotes',
    iconWrap: 'bg-butter text-ink',
    card: 'border-line bg-paper hover:bg-sand/40',
  },
];
---

<PanelLayout title="Inicio" active="inicio">
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="text-sm text-ink-2">{fmtDate(today, { weekday: 'long', day: 'numeric', month: 'long' })}</p>
      <h1 class="text-2xl font-medium tracking-[-0.02em] sm:text-3xl">{firstName ? `Hola, ${firstName}` : 'Hoy'}</h1>
    </div>
    <a href="/panel/agenda" class="btn-ghost hidden self-start sm:inline-flex sm:self-auto">
      <Icon name="heroicons:calendar-days" class="size-4" /> Ver agenda
    </a>
  </div>

  <div class="mt-5 grid grid-cols-2 gap-2.5 sm:mt-8 sm:gap-3 lg:grid-cols-4">
    {
      stats.map((s) => (
        <a href={s.href} data-lift class:list={['flex min-w-0 flex-col rounded-2xl border p-3.5 transition-colors sm:p-5', s.card]}>
          <span class="flex items-center justify-between gap-2">
            <span class="text-sm font-medium">{s.label}</span>
            <span class:list={['grid size-9 shrink-0 place-items-center rounded-xl', s.iconWrap]}>
              <Icon name={s.icon} class="size-5" />
            </span>
          </span>
          <p class="mt-4 text-2xl leading-none font-medium tracking-[-0.02em] tabular-nums sm:text-[28px]" data-count={s.count} data-money={s.money ? '1' : undefined}>{s.value}</p>
          <p class:list={['mt-2 truncate text-xs tabular-nums', s.metaTone]}>{s.meta}</p>
        </a>
      ))
    }
  </div>

  <div class="mt-5 grid gap-4 sm:mt-8 sm:gap-6 lg:grid-cols-2 [&>*]:min-w-0">
    <section class="rounded-2xl bg-paper p-4 border border-line sm:p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-medium">Próximos 7 días</h2>
        <a href="/panel/agenda" class="inline-flex items-center gap-1 text-sm font-medium text-brand-500 transition-colors hover:text-brand-600">Agenda <Icon name="heroicons:arrow-right" class="size-4" /></a>
      </div>
      {
        upcoming.data?.length ? (
          <ul class="mt-4 divide-y divide-line">
            {upcoming.data.map((r) => (
              <li>
                <a href={`/panel/solicitudes/${r.id}`} class="-mx-2 flex items-center gap-4 rounded-2xl px-2 py-3 transition hover:bg-sand/60" data-vt-row={r.id}>
                  <span class="flex w-12 shrink-0 flex-col items-center rounded-xl bg-sand py-1.5">
                    <span class="text-[11px] text-ink-3">{fmtDate(r.service_date, { weekday: 'short' }).replace('.', '')}</span>
                    <span class="text-lg leading-none font-medium">{r.service_date.slice(8, 10)}</span>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-medium" data-vt="name">{r.customer_name}</span>
                    <span class="block truncate text-xs text-ink-2">
                      {shortSlot(r.time_slot)} · {r.origin_address} <Icon name="heroicons:arrow-long-right" class="inline size-3.5 align-[-2px]" /> {r.destination_address}
                    </span>
                  </span>
                  <StatusBadge status={r.status} data-vt="status" />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-6 rounded-2xl bg-sand/60 p-6 text-center text-sm text-ink-2">No hay servicios en los próximos 7 días.</p>
        )
      }
    </section>

    <section class="rounded-2xl bg-paper p-4 border border-line sm:p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-medium">Solicitudes nuevas</h2>
        <a href="/panel/solicitudes?estado=nueva" class="inline-flex items-center gap-1 text-sm font-medium text-brand-500 transition-colors hover:text-brand-600">Ver todas <Icon name="heroicons:arrow-right" class="size-4" /></a>
      </div>
      {
        latest.data?.length ? (
          <ul class="mt-4 divide-y divide-line">
            {latest.data.map((r) => (
              <li>
                <a href={`/panel/solicitudes/${r.id}`} class="-mx-2 flex items-center gap-4 rounded-2xl px-2 py-3 transition hover:bg-sand/60" data-vt-row={r.id}>
                  <RequestThumb url={thumbs[r.id]} service={r.service} class="size-11" />
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-medium" data-vt="name">{r.customer_name}</span>
                    <span class="block truncate text-xs text-ink-2">
                      {r.service} · {timeAgo(r.created_at)}
                      {r.photos.length > 0 && ` · ${r.photos.length} ${r.photos.length === 1 ? 'foto' : 'fotos'}`}
                    </span>
                  </span>
                  <span class="text-right text-sm font-medium whitespace-nowrap">{r.estimated_price ? formatCOP(r.estimated_price) : ''}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-6 rounded-2xl bg-sand/60 p-6 text-center text-sm text-ink-2">Estás al día. No hay solicitudes nuevas.</p>
        )
      }
    </section>
  </div>

  <section class="mt-6 rounded-2xl bg-paper p-4 border border-line sm:p-6">
    <h2 class="text-lg font-medium">Por estado</h2>
    <div class="mt-4 flex h-2.5 gap-0.5 overflow-hidden rounded-full bg-sand">
      {
        STATUS_KEYS.map((s) => {
          const total = Object.values(byStatus).reduce((a, b) => a + b, 0) || 1;
          const share = (byStatus[s] / total) * 100;
          return share > 0 && <span class:list={[STATUSES[s].dot]} style={`width:${share}%`} title={`${STATUSES[s].label}: ${byStatus[s]}`} />;
        })
      }
    </div>
    <ul class="mt-4 grid grid-cols-2 gap-2 lg:grid-cols-5">
      {
        STATUS_KEYS.map((s) => (
          <li>
            <a href={`/panel/solicitudes?estado=${s}`} class="flex items-center gap-2.5 rounded-2xl border border-line px-2.5 py-2 transition hover:bg-sand/60">
              <span class:list={['grid size-8 shrink-0 place-items-center rounded-xl', STATUSES[s].iconWrap]}>
                <Icon name={STATUSES[s].icon} class="size-4" />
              </span>
              <span class="min-w-0">
                <span class="block truncate text-sm font-semibold">{STATUSES[s].label}</span>
                <span class="block text-xs text-ink-3 tabular-nums">{byStatus[s]}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</PanelLayout>

<script>
  import { gsap } from 'gsap';

  // Las cifras del resumen cuentan desde cero al cargar (sin animación si se pidió reducir movimiento)
  // Solo la primera vez de la sesión: al volver al Inicio las cifras ya están, sin "recargar"
  let seen = false;
  try {
    seen = sessionStorage.getItem('llevo:cifras') === '1';
    sessionStorage.setItem('llevo:cifras', '1');
  } catch {
    /* sin almacenamiento: se anima */
  }
  if (!seen && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const money = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count) || 0;
      if (!target) return;
      const isMoney = el.dataset.money === '1';
      const counter = { v: 0 };
      gsap.to(counter, {
        v: target,
        duration: 0.9,
        ease: 'power2.out',
        onUpdate: () => {
          el.textContent = isMoney ? money.format(Math.round(counter.v)) : String(Math.round(counter.v));
        },
      });
    });
  }
</script>
