---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<span class="flex items-center gap-2">
  <span class="grid size-9 place-items-center rounded-xl bg-brand-500 text-white shadow-md shadow-brand-500/30">
    <svg viewBox="0 0 24 24" fill="none" class="size-5" aria-hidden="true">
      <path d="M3 7.5h10.5v9H3zM13.5 10.5h4l3 3v3h-7z" fill="currentColor" />
      <circle cx="7" cy="17.5" r="1.8" fill="#1c1917" stroke="currentColor" stroke-width="1" />
      <circle cx="17" cy="17.5" r="1.8" fill="#1c1917" stroke="currentColor" stroke-width="1" />
    </svg>
  </span>
  <span class="font-display text-xl font-bold tracking-tight">{name}</span>
</span>
