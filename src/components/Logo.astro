---
/**
 * Logo de Llevo: la palabra como un sticker pegado con cinta.
 * variant "color" (azul) para fondos claros, "inverso" (blanco) para fondos azules u oscuros.
 */
interface Props {
  height?: number;
  variant?: 'color' | 'inverso';
  label?: string;
}
const { height = 36, variant = 'color', label } = Astro.props;
const src = variant === 'inverso' ? '/brand/llevo-logo-inverso.svg' : '/brand/llevo-logo.svg';
const width = Math.round((height * 634) / 383);
---

<span class="inline-flex items-center gap-2">
  <img src={src} alt="Llevo" width={width} height={height} class="block" loading="eager" decoding="async" />
  {label && <span class="font-display text-lg font-semibold text-ink-2">{label}</span>}
</span>
