---
/**
 * Logo: la vuelta al lado de la palabra, en la tipografía de los títulos.
 * En claro la figura es azul; sobre tinta, blanca.
 */
interface Props {
  height?: number;
  variant?: 'color' | 'inverso';
  label?: string;
}
const { height = 36, variant = 'color', label } = Astro.props;
const onDark = variant === 'inverso';
const mark = onDark ? '#f4f6fb' : '#2F5BEA';
---

<span data-logo class="inline-flex items-center" style={`font-size: ${height}px`}>
  <svg viewBox="40 42 176 172" class="block h-[0.72em] w-auto" aria-hidden="true">
    <path
      fill={mark}
      d="M112 78V128a14 14 0 0 0 14 14h54a36 36 0 0 1 0 72H76a36 36 0 0 1-36-36V78a36 36 0 0 1 72 0z"></path>
  </svg>
  <span
    class:list={[
      'ml-[0.2em] font-display leading-none font-semibold tracking-[-0.045em]',
      onDark ? 'text-[#f4f6fb]' : 'text-ink',
    ]}
    style="font-size: 0.78em">llevo</span
  >
  {
    label && (
      <span
        class:list={[
          'ml-2 font-display text-lg font-medium tracking-[-0.02em]',
          onDark ? 'text-[#b4bdd4]' : 'text-ink-3',
        ]}
      >
        {label}
      </span>
    )
  }
</span>
