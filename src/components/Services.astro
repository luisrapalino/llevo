---
import { Icon } from 'astro-icon/components';

import type { Service } from '../lib/settings';

const { services } = Astro.props as { services: Service[] };
const tones = ['bg-brand-500 text-white', 'bg-ink text-white', 'bg-amber-300 text-ink', 'bg-emerald-500 text-white'];
---

<section id="servicios" class="scroll-mt-20 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <span class="section-eyebrow">Servicios</span>
        <h2 class="section-title mt-4">Lo que necesites mover, lo movemos.</h2>
      </div>
      <p class="max-w-sm text-stone-600">
        Servicio personalizado con un solo vehículo: tu carga viaja sola, sin mezclarse con la de nadie más.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s, i) => (
          <article class="group flex flex-col rounded-3xl bg-white p-6 ring-1 ring-stone-200/80 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-stone-900/5">
            <span class:list={['grid size-12 place-items-center rounded-2xl transition group-hover:scale-110', tones[i % tones.length]]}>
              <Icon name={s.icon} class="size-6" />
            </span>
            <h3 class="mt-6 font-display text-xl font-bold">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{s.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
