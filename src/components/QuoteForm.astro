---
import { Icon } from 'astro-icon/components';
import { COMMON_ITEMS, FLOORS, LOAD_SIZES, SERVICE_TYPES, TIME_SLOTS } from '../lib/constants';
import { cityName, waNumber, type Business, type Pricing } from '../lib/settings';

interface Props {
  business: Business;
  pricing: Pricing;
  blocked: { date: string; time_slot: string | null }[];
  apiEnabled: boolean;
}
const { business, pricing, blocked, apiEnabled } = Astro.props;

const steps = [
  { id: 'servicio', title: 'Servicio', hint: 'Qué necesitas', icon: 'heroicons:squares-plus' },
  { id: 'ruta', title: 'Ruta', hint: 'Desde y hasta', icon: 'heroicons:map-pin' },
  { id: 'carga', title: 'Tu carga', hint: 'Fotos y detalles', icon: 'heroicons:photo' },
  { id: 'fecha', title: 'Fecha y hora', hint: 'Cuándo', icon: 'heroicons:calendar-days' },
  { id: 'contacto', title: 'Contacto', hint: 'A qué número te escribo', icon: 'heroicons:user' },
];

const serviceTypes = SERVICE_TYPES;
const loadSizes = LOAD_SIZES;
const commonItems = COMMON_ITEMS;
const timeSlots = TIME_SLOTS;
const floors = FLOORS;
---

<section id="cotizar" class="scroll-mt-16 bg-sand/70 py-14 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <span class="section-eyebrow">Cotización gratis</span>
      <h2 class="section-title mt-4">Cuéntame qué hay que llevar</h2>
      <p class="mt-4 text-ink-2">Con fotos se ve si cabe en la camioneta y te doy un precio más exacto.</p>
    </div>

    <div class="mt-7 grid gap-6 sm:mt-12 lg:grid-cols-[260px_1fr] [&>*]:min-w-0">
      <!-- Stepper lateral (desktop) -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
        <div class="relative" data-stepper-wrap>
        <ol class="relative space-y-1" data-stepper>
          {
            steps.map((s, i) => (
              <li>
                <button
                  type="button"
                  data-step-link={i}
                  class="group flex w-full items-center gap-3 rounded-2xl p-3 text-left transition enabled:hover:bg-paper/70 disabled:cursor-default"
                >
                  <span class="step-dot grid size-10 shrink-0 place-items-center rounded-xl bg-paper text-ink-3 border border-line transition">
                    <Icon name={s.icon} class="step-icon size-5" />
                    <Icon name="heroicons:check" class="step-check hidden size-5" />
                  </span>
                  <span>
                    <span class="step-title block text-sm font-medium text-ink-2">{s.title}</span>
                    <span class="block text-xs text-ink-3">{s.hint}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
        </div>

        <div class="mt-8 rounded-2xl bg-paper/70 p-4 text-sm text-ink-2 border border-line">
          <p class="flex items-center gap-2 font-medium text-ink">
            <Icon name="heroicons:lock-closed" class="size-4 text-ink-3" /> Tus datos están seguros
          </p>
          <p class="mt-1">Solo los uso para cotizar y coordinar el viaje.</p>
        </div>
        </div>
      </aside>

      <!-- Formulario -->
      <div data-form-card class="-mx-4 border-y border-line bg-cream px-4 py-5 sm:mx-0 sm:rounded-[20px] sm:border sm:p-8">
        <!-- Progreso (móvil) -->
        <div class="mb-6 lg:hidden" data-mobile-progress>
          <div class="flex items-center justify-between text-sm">
            <span class="font-medium" data-mobile-title>{steps[0].title}</span>
            <span class="text-ink-2">Paso <span data-mobile-step>1</span> de {steps.length}</span>
          </div>
          <!-- Ruta de pasos (móvil): el pin avanza por la curva -->
          <div class="mt-1 h-12" data-mobile-route></div>
        </div>

        <form
          id="quote-form"
          novalidate
          data-api={apiEnabled ? '1' : ''}
          data-whatsapp={waNumber(business.whatsapp)}
          data-pricing={pricing.showEstimate ? JSON.stringify(pricing) : ''}
          data-blocked={JSON.stringify(blocked)}
        >
          <!-- Honeypot anti-spam -->
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <!-- PASO 1 · Servicio -->
          <fieldset data-step="0" class="space-y-6 sm:space-y-8">
            <legend class="sr-only">Tipo de servicio</legend>
            <div>
              <h3 class="text-xl font-medium tracking-[-0.01em] sm:text-2xl">¿Qué necesitas?</h3>
              <p class="mt-1 text-sm text-ink-2">Elige la opción que mejor describa tu servicio.</p>
              <div class="mt-4 grid grid-cols-2 gap-2.5 sm:mt-5 sm:gap-3">
                {
                  serviceTypes.map((s, i) => (
                    <label class="choice flex-col items-start gap-2 p-3 sm:flex-row sm:items-center sm:gap-4 sm:p-4">
                      <input type="radio" name="servicio" value={s.value} class="sr-only" required checked={i === 0} />
                      <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-sand text-ink-2 sm:size-10">
                        <Icon name={s.icon} class="size-5 sm:size-6" />
                      </span>
                      <span>
                        <span class="block text-[15px] leading-snug font-medium sm:text-base">{s.label}</span>
                        <span class="block text-xs text-ink-2 sm:text-sm">{s.text}</span>
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>

            <div>
              <h4 class="font-medium">¿Qué tanto vas a llevar?</h4>
              <div class="mt-3 grid grid-cols-3 gap-2 sm:gap-3">
                {
                  loadSizes.map((l, i) => (
                    <label class="choice flex-col p-3 sm:p-4">
                      <input type="radio" name="tamano" value={l.value} class="sr-only" required checked={i === 0} />
                      <span class="flex items-end gap-1" aria-hidden="true">
                        {[0, 1, 2].map((b) => (
                          <span data-bar class:list={['w-2.5 origin-bottom rounded-sm', b <= i ? 'bg-brand-500' : 'bg-sand', ['h-3', 'h-5', 'h-7'][b]]} />
                        ))}
                      </span>
                      <span class="mt-2.5 text-sm leading-snug font-medium sm:mt-3 sm:text-base">{l.value}</span>
                      <span class="text-xs text-ink-2 sm:text-sm">{l.text}</span>
                    </label>
                  ))
                }
              </div>
            </div>
          </fieldset>

          <!-- PASO 2 · Ruta -->
          <fieldset data-step="1" class="hidden space-y-6">
            <legend class="sr-only">Direcciones</legend>
            <div>
              <h3 class="text-2xl font-medium tracking-[-0.01em]">¿Desde dónde y hasta dónde?</h3>
              <p class="mt-1 text-sm text-ink-2">Incluye barrio o una referencia para llegar más fácil.</p>
              <p class="mt-3 inline-flex items-center gap-2 rounded-lg bg-butter-soft px-3 py-1.5 text-sm text-ink">
                <Icon name="heroicons:map-pin" class="size-4 text-ink-2" /> Por ahora solo en {cityName(business)}
              </p>
            </div>

            <div class="overflow-hidden rounded-2xl border border-line bg-paper" data-route-map-wrap>
              <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
                <div class="inline-flex rounded-xl bg-sand p-1" role="group" aria-label="Punto que vas a marcar en el mapa">
                  <button type="button" data-map-target="origen" aria-pressed="true" class="inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-semibold text-ink-2 transition-colors aria-pressed:bg-paper aria-pressed:text-ink aria-pressed:shadow-[0_1px_2px_rgba(20,33,61,0.08)]">
                    <span class="size-2.5 rounded-full border-2 border-ink bg-paper" aria-hidden="true"></span> Recogida
                  </button>
                  <button type="button" data-map-target="destino" aria-pressed="false" class="inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-semibold text-ink-2 transition-colors aria-pressed:bg-paper aria-pressed:text-ink aria-pressed:shadow-[0_1px_2px_rgba(20,33,61,0.08)]">
                    <span class="size-2.5 rounded-full bg-brand-500" aria-hidden="true"></span> Entrega
                  </button>
                </div>
                <p class="text-xs text-ink-3" data-map-hint>Toca el mapa para marcar la recogida, o escribe la dirección abajo</p>
              </div>
              <div class="relative h-64 border-t border-line bg-cream sm:h-80" data-route-map>
                <div class="absolute inset-0 grid place-items-center text-sm text-ink-3" data-map-loading>Cargando mapa…</div>
              </div>
              <p class="hidden items-center gap-2 border-t border-line px-4 py-2.5 text-sm text-ink-2" data-map-distance>
                <Icon name="heroicons:arrows-right-left" class="size-4 text-ink-3" /> <span></span>
              </p>
            </div>

            {
              [
                { key: 'origen', label: 'Recogida', icon: '', tone: 'bg-sand' },
                { key: 'destino', label: 'Entrega', icon: 'heroicons:flag-solid', tone: 'bg-brand-500 text-white' },
              ].map((p) => (
                <div class="rounded-2xl bg-paper p-5 border border-line">
                  <div class="flex items-center justify-between gap-3">
                    <p class="flex items-center gap-3 font-medium">
                      <span class:list={['grid size-8 place-items-center rounded-full', p.tone]}>
                        {p.icon ? <Icon name={p.icon} class="size-4" /> : <span class="size-3.5 rounded-full border-[3px] border-ink bg-paper" />}
                      </span>
                      {p.label}
                    </p>
                    {p.key === 'origen' && (
                      <button type="button" data-geo class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium text-brand-500 transition-colors hover:bg-brand-50">
                        <Icon name="heroicons:map" class="size-4" />
                        <span data-geo-label>Usar mi ubicación</span>
                      </button>
                    )}
                  </div>

                  <div class="mt-4 grid gap-4 sm:grid-cols-2">
                    <div class="sm:col-span-2">
                      <label for={`${p.key}-dir`} class="field-label">Dirección</label>
                      <div class="relative">
                        <input
                          id={`${p.key}-dir`}
                          name={`${p.key}_direccion`}
                          class="field"
                          required
                          autocomplete="off"
                          data-place={p.key}
                          role="combobox"
                          aria-expanded="false"
                          aria-autocomplete="list"
                          aria-controls={`${p.key}-sugerencias`}
                          placeholder="Ej. Calle 16 #9-45, apto 302"
                        />
                        <ul
                          id={`${p.key}-sugerencias`}
                          role="listbox"
                          class="absolute inset-x-0 top-full z-20 mt-1 hidden overflow-hidden rounded-xl border border-line bg-paper py-1 shadow-[0_8px_24px_rgba(20,33,61,0.10)]"
                          data-suggest={p.key}
                        ></ul>
                      </div>
                    </div>
                    <div class="sm:col-span-2">
                      <label for={`${p.key}-ref`} class="field-label">
                        Barrio / referencia <span class="font-normal text-ink-3">(opcional)</span>
                      </label>
                      <input id={`${p.key}-ref`} name={`${p.key}_referencia`} class="field" placeholder="Ej. Barrio Novalito, frente al parque" />
                    </div>
                    <div>
                      <label for={`${p.key}-piso`} class="field-label">Piso</label>
                      <select id={`${p.key}-piso`} name={`${p.key}_piso`} class="field appearance-none bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 20 20%22 fill=%22%2378716c%22><path fill-rule=%22evenodd%22 d=%22M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z%22/></svg>')] bg-[length:1.25rem] bg-[right_0.75rem_center] bg-no-repeat pr-10">
                        {floors.map((f) => <option value={f}>{f === 'Primer piso' ? f : `Piso ${f}`}</option>)}
                      </select>
                    </div>
                    <div>
                      <span class="field-label">¿Hay ascensor?</span>
                      <div class="flex gap-2">
                        <label class="chip flex-1 justify-center py-3">
                          <input type="radio" name={`${p.key}_ascensor`} value="Sí" class="sr-only" /> Sí
                        </label>
                        <label class="chip flex-1 justify-center py-3">
                          <input type="radio" name={`${p.key}_ascensor`} value="No" class="sr-only" checked /> No
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
            <input type="hidden" name="origen_ubicacion" data-geo-value />
            <input type="hidden" name="destino_ubicacion" data-dest-value />
            <input type="hidden" data-route-km value="" />
          </fieldset>

          <!-- PASO 3 · Carga -->
          <fieldset data-step="2" class="hidden space-y-8">
            <legend class="sr-only">Qué vas a llevar</legend>
            <div>
              <h3 class="text-2xl font-medium tracking-[-0.01em]">¿Qué hay que llevar?</h3>
              <p class="mt-1 text-sm text-ink-2">Con fotos veo si cabe y te doy un precio más exacto.</p>
            </div>

            <!-- Dropzone -->
            <div>
              <label
                data-dropzone
                class="group flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-line-strong bg-paper px-6 py-10 text-center transition hover:border-brand-400 hover:bg-brand-50/50 data-[drag=true]:border-brand-500 data-[drag=true]:bg-brand-50"
              >
                <span class="grid size-14 place-items-center rounded-2xl bg-brand-100 text-ink-3 transition">
                  <Icon name="heroicons:camera" class="size-7" />
                </span>
                <span class="mt-4 font-medium">Sube o toma fotos</span>
                <span class="mt-1 text-sm text-ink-2">Arrastra aquí o toca para elegir · hasta 10 fotos</span>
                <input type="file" accept="image/*" multiple class="sr-only" data-file-input />
              </label>
              <ul class="mt-4 grid grid-cols-3 gap-3 empty:hidden sm:grid-cols-5" data-previews></ul>
            </div>

            <div>
              <h4 class="font-medium">Marca lo que aplica <span class="font-normal text-ink-3">(opcional)</span></h4>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  commonItems.map((it) => (
                    <label class="chip">
                      <input type="checkbox" name="objetos" value={it} class="sr-only" />
                      {it}
                    </label>
                  ))
                }
              </div>
            </div>

            <div>
              <label for="descripcion" class="field-label">Describe tu carga</label>
              <textarea
                id="descripcion"
                name="descripcion"
                rows="4"
                class="field resize-none"
                required
                minlength="10"
                placeholder="Ej. Una nevera mediana, una cama doble desarmada, 8 cajas medianas y un escritorio."></textarea>
            </div>

            <div>
              <h4 class="font-medium">Servicios adicionales</h4>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                <div class="rounded-2xl bg-paper p-4 border border-line">
                  <p class="flex items-center gap-2 text-sm font-medium">
                    <Icon name="heroicons:user-group" class="size-5 text-ink-3" /> ¿Alguien más para cargar?
                  </p>
                  <div class="mt-3 flex gap-2">
                    {
                      ['0', '1', '2', '3+'].map((n, i) => (
                        <label class="chip flex-1 justify-center">
                          <input type="radio" name="ayudantes" value={n} class="sr-only" checked={i === 0} />
                          {n}
                        </label>
                      ))
                    }
                  </div>
                </div>
                <div class="space-y-2">
                  <label class="choice items-center gap-3 !py-3">
                    <input type="checkbox" name="extras" value="Desarme y armado" class="peer sr-only" />
                    <Icon name="heroicons:wrench-screwdriver" class="size-5 text-ink-3" />
                    <span class="text-sm font-medium">Desarme y armado de muebles</span>
                  </label>
                  <label class="choice items-center gap-3 !py-3">
                    <input type="checkbox" name="extras" value="Material de embalaje" class="sr-only" />
                    <Icon name="heroicons:cube" class="size-5 text-ink-3" />
                    <span class="text-sm font-medium">Material de embalaje</span>
                  </label>
                </div>
              </div>
            </div>
          </fieldset>

          <!-- PASO 4 · Fecha y hora -->
          <fieldset data-step="3" class="hidden space-y-8">
            <legend class="sr-only">Fecha y hora</legend>
            <div>
              <h3 class="text-2xl font-medium tracking-[-0.01em]">¿Cuándo lo hacemos?</h3>
              <p class="mt-1 text-sm text-ink-2">Elige el día y la franja horaria que prefieras.</p>
            </div>

            <div>
              <span class="field-label">Día</span>
              <div class="flex gap-2 overflow-x-auto pb-2 [scrollbar-width:none]" data-days></div>
              <p class="mt-2 hidden text-sm text-red-600" data-date-msg>Ese día no tenemos disponibilidad. Elige otra fecha.</p>
              <div class="mt-3 flex items-center gap-3">
                <label for="fecha" class="text-sm text-ink-2">u otra fecha:</label>
                <input id="fecha" name="fecha" type="date" class="field !w-auto !py-2" required />
              </div>
            </div>

            <div>
              <span class="field-label">Franja horaria</span>
              <div class="grid gap-3 sm:grid-cols-2">
                {
                  timeSlots.map((t) => (
                    <label class="choice items-center gap-3 has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-40" data-slot-label>
                      <input type="radio" name="franja" value={t.value} class="sr-only" required />
                      <Icon name={t.icon} class="size-5 text-ink-3" />
                      <span class="text-sm font-medium">{t.value}</span>
                    </label>
                  ))
                }
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="hora" class="field-label">
                  Hora exacta <span class="font-normal text-ink-3">(opcional)</span>
                </label>
                <input id="hora" name="hora" type="time" class="field" />
              </div>
              <label class="choice items-center gap-3 self-end">
                <input type="checkbox" name="flexible" value="Sí" class="sr-only" />
                <Icon name="heroicons:arrows-right-left" class="size-5 text-ink-3" />
                <span class="text-sm font-medium">Tengo flexibilidad de fecha u hora</span>
              </label>
            </div>
          </fieldset>

          <!-- PASO 5 · Contacto -->
          <fieldset data-step="4" class="hidden space-y-6">
            <legend class="sr-only">Datos de contacto</legend>
            <div>
              <h3 class="text-2xl font-medium tracking-[-0.01em]">¿A qué número te escribo?</h3>
              <p class="mt-1 text-sm text-ink-2">Te mando la cotización a este WhatsApp.</p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label for="nombre" class="field-label">Nombre</label>
                <input id="nombre" name="nombre" class="field" required autocomplete="name" placeholder="¿Cómo te llamas?" />
              </div>
              <div>
                <label for="telefono" class="field-label">Celular / WhatsApp</label>
                <input
                  id="telefono"
                  name="telefono"
                  type="tel"
                  inputmode="tel"
                  class="field"
                  required
                  autocomplete="tel"
                  pattern="[0-9\s\+\(\)\-]{7,}"
                  placeholder="300 123 4567"
                />
              </div>
              <div>
                <label for="email" class="field-label">
                  Correo <span class="font-normal text-ink-3">(opcional)</span>
                </label>
                <input id="email" name="email" type="email" class="field" autocomplete="email" placeholder="tu@correo.com" />
              </div>
            </div>

            <div>
              <span class="field-label">Prefiero que me contacten por</span>
              <div class="flex flex-wrap gap-2">
                {
                  [
                    { v: 'WhatsApp', i: 'heroicons:chat-bubble-left-right' },
                    { v: 'Llamada', i: 'heroicons:phone' },
                    { v: 'Correo', i: 'heroicons:envelope' },
                  ].map((c, idx) => (
                    <label class="chip">
                      <input type="radio" name="contacto_preferido" value={c.v} class="sr-only" checked={idx === 0} />
                      <Icon name={c.i} class="size-4" />
                      {c.v}
                    </label>
                  ))
                }
              </div>
            </div>

            <div>
              <label for="notas" class="field-label">
                ¿Algo más que deba saber? <span class="font-normal text-ink-3">(opcional)</span>
              </label>
              <textarea id="notas" name="notas" rows="3" class="field resize-none" placeholder="Ej. La calle es estrecha, hay que pedir permiso en portería, etc."></textarea>
            </div>

            <div class="hidden items-center justify-between gap-4 rounded-2xl bg-ink p-5 text-white" data-estimate-box>
              <div>
                <p class="text-sm text-[#b4bdd4]">Precio estimado</p>
                <p class="text-3xl font-medium tracking-[-0.02em]" data-estimate>—</p>
                <p class="mt-1 hidden text-xs text-[#b4bdd4]" data-estimate-km></p>
                <p class="mt-1 text-xs text-[#b4bdd4]">Valor de referencia. Te confirmo el precio final al revisar tus fotos.</p>
              </div>
              <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-brand-500">
                <Icon name="heroicons:calculator" class="size-6" />
              </span>
            </div>

            <label class="flex items-start gap-3 text-sm text-ink-2">
              <input type="checkbox" name="acepta_datos" value="Sí" required class="mt-0.5 size-5 shrink-0 rounded-md accent-brand-500" />
              <span>Autorizo el uso de mis datos para recibir la cotización y coordinar el servicio.</span>
            </label>
          </fieldset>

          <!-- Navegación -->
          <div class="mt-10 flex items-center justify-between gap-3 border-t border-line pt-6">
            <button type="button" class="btn-ghost invisible" data-prev>
              <Icon name="heroicons:arrow-left" class="size-4" /> Atrás
            </button>
            <button type="button" class="btn-primary" data-next>
              Continuar <Icon name="heroicons:arrow-right" class="size-4" />
            </button>
            <button type="submit" class="btn-primary hidden" data-submit>
              <Icon name="heroicons:paper-airplane" class="size-4" />
              <span data-submit-label>Enviar solicitud</span>
            </button>
          </div>
          <p class="mt-4 hidden rounded-2xl bg-red-50 p-3 text-sm text-red-700" data-form-error></p>
        </form>

        <!-- Éxito -->
        <div class="hidden py-8 text-center" data-success>
          <div class="mx-auto h-24 w-60" data-success-route></div>
          <h3 class="mt-6 text-3xl font-medium tracking-[-0.02em]">Solicitud enviada</h3>
          <p class="mt-2 hidden text-sm text-ink-2" data-success-code-wrap>
            Código de tu solicitud: <span class="rounded-lg bg-sand px-2 py-0.5 font-mono font-medium text-ink" data-success-code></span>
          </p>
          <p class="mx-auto mt-3 max-w-md text-ink-2" data-success-text>
            Reviso tus fotos y te escribo la cotización muy pronto.
          </p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="#" target="_blank" rel="noopener" class="btn-primary" data-success-wa>
              <Icon name="heroicons:chat-bubble-left-right" class="size-4" /> Continuar por WhatsApp
            </a>
            <button type="button" class="btn-ghost" data-reset>Hacer otra solicitud</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { estimate, routeNote, type EstimateInput } from '../lib/pricing';
  import { toast } from '../lib/toast';
  import { gsap } from 'gsap';

  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  import type { Pricing } from '../lib/settings';
  import { chimeSuccess } from '../lib/sounds';
  import { stepRoute } from '../scripts/step-route';

  const MAX_FILES = 10;
  const MAX_DIM = 1600;

  const form = document.querySelector<HTMLFormElement>('#quote-form')!;
  const stepsEls = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
  const stepLinks = [...document.querySelectorAll<HTMLButtonElement>('[data-step-link]')];
  const prevBtn = form.querySelector<HTMLButtonElement>('[data-prev]')!;
  const nextBtn = form.querySelector<HTMLButtonElement>('[data-next]')!;
  const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const submitLabel = form.querySelector<HTMLSpanElement>('[data-submit-label]')!;
  const mobileProgress = document.querySelector<HTMLElement>('[data-mobile-progress]')!;
  const formCard = document.querySelector<HTMLElement>('[data-form-card]')!;
  const mobileStep = document.querySelector<HTMLElement>('[data-mobile-step]')!;
  const mobileTitle = document.querySelector<HTMLElement>('[data-mobile-title]')!;
  const formError = form.querySelector<HTMLElement>('[data-form-error]')!;
  const success = document.querySelector<HTMLElement>('[data-success]')!;
  const stepTitles = stepLinks.map((b) => b.querySelector('.step-title')?.textContent ?? '');

  let current = 0;
  let maxReached = 0;
  let photos: File[] = [];

  /* ---------- Navegación entre pasos ---------- */
  function render() {
    stepsEls.forEach((el, i) => el.classList.toggle('hidden', i !== current));
    prevBtn.classList.toggle('invisible', current === 0);
    const last = current === stepsEls.length - 1;
    nextBtn.classList.toggle('hidden', last);
    submitBtn.classList.toggle('hidden', !last);
    mobileStep.textContent = String(current + 1);
    mobileTitle.textContent = stepTitles[current] || '';

    stepLinks.forEach((btn, i) => {
      const dot = btn.querySelector<HTMLElement>('.step-dot')!;
      const title = btn.querySelector<HTMLElement>('.step-title')!;
      const done = i < current || (i <= maxReached && i !== current);
      dot.className = 'step-dot grid size-10 shrink-0 place-items-center rounded-xl ring-1 transition ' +
        (i === current
          ? 'bg-brand-500 text-white ring-brand-500 '
          : done
            ? 'bg-ink text-white ring-ink'
            : 'bg-paper text-ink-3 ring-line');
      btn.querySelector('.step-icon')?.classList.toggle('hidden', done);
      btn.querySelector('.step-check')?.classList.toggle('hidden', !done);
      title.classList.toggle('text-ink', i <= maxReached);
      title.classList.toggle('text-ink-2', i > maxReached);
      btn.disabled = i > maxReached;
      btn.toggleAttribute('aria-current', i === current);
    });
    drawRoute();
  }

  /* ---------- Ruta entre los pasos, con el pin del logo ---------- */
  const relTo = (wrap: HTMLElement, el: Element): [number, number] => {
    const a = wrap.getBoundingClientRect(), r = el.getBoundingClientRect();
    return [r.left + r.width / 2 - a.left, r.top + r.height / 2 - a.top];
  };
  const deskWrap = document.querySelector<HTMLElement>('[data-stepper-wrap]');
  const deskRoute = deskWrap
    ? stepRoute({
        wrap: deskWrap,
        points: () => stepLinks.map((b) => relTo(deskWrap, b.querySelector('.step-dot')!)),
        bend: 48,
        gap: 24,
        pinSize: 26,
        reduce: reduceMotion,
        // el paso al que llega da un pequeño salto
        onLand: (i) => gsap.fromTo(stepLinks[i]?.querySelector('.step-dot') ?? [], { scale: 0.88 }, { scale: 1, duration: 0.5, ease: 'back.out(3)' }),
      })
    : null;
  const mobileWrap = document.querySelector<HTMLElement>('[data-mobile-route]');
  const mobileRoute = mobileWrap
    ? stepRoute({
        wrap: mobileWrap,
        points: () => {
          const W = mobileWrap.clientWidth, n = stepLinks.length || stepsEls.length;
          return Array.from({ length: n }, (_, i) => [8 + ((W - 16) * i) / (n - 1), 36] as [number, number]);
        },
        bend: 7,
        dots: true,
        pinSize: 24,
        duration: 0.8,
        reduce: reduceMotion,
      })
    : null;
  const drawRoute = () => {
    deskRoute?.go(current);
    mobileRoute?.go(current);
  };

  /** Pantalla de éxito: la ruta se recorre completa y el pin aterriza en el destino. */
  const successWrap = success.querySelector<HTMLElement>('[data-success-route]');
  let successRoute: ReturnType<typeof stepRoute> | null = null;
  function arrive() {
    if (!successWrap) return;
    successRoute ??= stepRoute({
      wrap: successWrap,
      points: () => {
        const W = successWrap.clientWidth, H = successWrap.clientHeight;
        return [[10, H - 18], [W * 0.36, H - 30], [W * 0.66, H - 14], [W - 14, H - 26]];
      },
      bend: 14,
      dots: true,
      pinSize: 46,
      duration: 1.5,
      reduce: reduceMotion,
      onLand: () => gsap.fromTo(successWrap, { scale: 0.97 }, { scale: 1, duration: 0.4, ease: 'back.out(3)' }),
    });
    requestAnimationFrame(() => {
      successRoute!.build();
      successRoute!.go(0, { instant: true });
      successRoute!.go(3);
    });
  }

  function validateStep(i: number) {
    const fields = [...stepsEls[i].querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select')];
    fields.forEach((f) => f.removeAttribute('aria-invalid'));
    const invalid = fields.find((f) => !f.checkValidity());
    if (invalid) {
      invalid.setAttribute('aria-invalid', 'true');
      invalid.dispatchEvent(new CustomEvent('llevo:invalid', { bubbles: true }));
      invalid.reportValidity();
      if (!(invalid instanceof HTMLInputElement && (invalid.type === 'radio' || invalid.type === 'checkbox'))) invalid.focus();
      return false;
    }
    return true;
  }

  function goTo(i: number) {
    const dir = i >= current ? 1 : -1;
    current = Math.max(0, Math.min(i, stepsEls.length - 1));
    maxReached = Math.max(maxReached, current);
    render();
    updateEstimate();
    if (!reduceMotion()) {
      // El paso nuevo entra desde la dirección en la que avanzas
      gsap.fromTo(stepsEls[current], { autoAlpha: 0, x: 16 * dir }, { autoAlpha: 1, x: 0, duration: 0.35, ease: 'power3.out', clearProps: 'transform' });
    }
    const top = document.querySelector('[data-form-card]')!.getBoundingClientRect().top;
    if (top < 0) window.scrollBy({ top: top - 90, behavior: 'smooth' });
  }

  nextBtn.addEventListener('click', () => validateStep(current) && goTo(current + 1));
  prevBtn.addEventListener('click', () => goTo(current - 1));
  stepLinks.forEach((btn, i) =>
    btn.addEventListener('click', () => {
      if (i <= maxReached && (i < current || validateStep(current))) goTo(i);
    }),
  );
  form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute('aria-invalid'));
  form.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.target as HTMLElement).tagName === 'INPUT' && current < stepsEls.length - 1) {
      e.preventDefault();
      nextBtn.click();
    }
  });

  /* ---------- Fecha: chips de próximos días ---------- */
  const dateInput = form.querySelector<HTMLInputElement>('#fecha')!;
  const daysWrap = form.querySelector<HTMLElement>('[data-days]')!;
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const today = new Date();
  dateInput.min = iso(today);
  const dayFmt = new Intl.DateTimeFormat('es-CO', { weekday: 'short' });
  const monFmt = new Intl.DateTimeFormat('es-CO', { month: 'short' });
  const blocked = JSON.parse(form.dataset.blocked || '[]') as { date: string; time_slot: string | null }[];
  const dayBlocked = (d: string) => blocked.some((b) => b.date === d && !b.time_slot);
  const slotBlocked = (d: string, slot: string) => blocked.some((b) => b.date === d && b.time_slot === slot);
  const dateMsg = form.querySelector<HTMLElement>('[data-date-msg]')!;
  const slotInputs = [...form.querySelectorAll<HTMLInputElement>('input[name="franja"]')];

  for (let k = 0; k < 10; k++) {
    const d = new Date(today);
    d.setDate(today.getDate() + k);
    const b = document.createElement('button');
    b.type = 'button';
    b.dataset.date = iso(d);
    b.className =
      'flex w-16 shrink-0 flex-col items-center rounded-2xl bg-paper py-3 border border-line transition hover:bg-sand/60 aria-pressed:bg-ink aria-pressed:text-white aria-pressed:ring-ink';
    const label = k === 0 ? 'Hoy' : k === 1 ? 'Mañana' : dayFmt.format(d).replace('.', '');
    if (dayBlocked(iso(d))) {
      b.disabled = true;
      b.title = 'Sin disponibilidad';
      b.classList.add('opacity-40', 'line-through', 'cursor-not-allowed');
    }
    b.innerHTML = `<span class="text-[11px] font-medium opacity-60">${label}</span><span class="text-xl font-medium">${d.getDate()}</span><span class="text-[11px] opacity-60">${monFmt.format(d).replace('.', '')}</span>`;
    b.addEventListener('click', () => {
      dateInput.value = b.dataset.date!;
      dateInput.removeAttribute('aria-invalid');
      applyDate();
    });
    daysWrap.append(b);
  }
  function applyDate() {
    const d = dateInput.value;
    daysWrap.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.date === d)));
    const full = !!d && dayBlocked(d);
    dateInput.setCustomValidity(full ? 'Ese día no tenemos disponibilidad.' : '');
    dateMsg.classList.toggle('hidden', !full);
    slotInputs.forEach((input) => {
      input.disabled = full || (!!d && slotBlocked(d, input.value));
      if (input.disabled) input.checked = false;
    });
  }
  dateInput.addEventListener('change', applyDate);

  /* ---------- Precio estimado ---------- */
  const pricing: Pricing | null = form.dataset.pricing ? JSON.parse(form.dataset.pricing) : null;
  const estimateBox = form.querySelector<HTMLElement>('[data-estimate-box]')!;
  const estimateEl = form.querySelector<HTMLElement>('[data-estimate]')!;
  const estimateKm = form.querySelector<HTMLElement>('[data-estimate-km]')!;
  const routeKmInput = form.querySelector<HTMLInputElement>('[data-route-km]');
  const cop = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
  function estimateInput(data: FormData): EstimateInput {
    const g = (k: string) => String(data.get(k) ?? '');
    return {
      load_size: g('tamano'),
      origin_floor: g('origen_piso'),
      origin_elevator: g('origen_ascensor') === 'Sí',
      destination_floor: g('destino_piso'),
      destination_elevator: g('destino_ascensor') === 'Sí',
      helpers: g('ayudantes'),
      extras: data.getAll('extras').map(String),
      service_date: g('fecha') || null,
      distance_km: currentKm(),
    };
  }
  function currentKm(): number | null {
    const raw = routeKmInput?.value ?? '';
    if (!raw) return null;
    const n = Number(raw);
    return Number.isFinite(n) ? n : null;
  }
  function updateEstimate() {
    if (!pricing) return;
    const km = currentKm();
    const value = estimate(estimateInput(new FormData(form)), pricing);
    estimateBox.classList.toggle('hidden', value == null);
    estimateBox.classList.toggle('flex', value != null);
    if (value != null) estimateEl.textContent = `Desde ${cop.format(value)}`;
    const note = routeNote(km, pricing);
    estimateKm.textContent = note ?? '';
    estimateKm.classList.toggle('hidden', !note);
  }
  form.addEventListener('change', updateEstimate);
  window.addEventListener('llevo:route', () => updateEstimate());

  /* ---------- Geolocalización ---------- */
  const geoBtn = form.querySelector<HTMLButtonElement>('[data-geo]');
  const geoLabel = form.querySelector<HTMLElement>('[data-geo-label]');
  const geoValue = form.querySelector<HTMLInputElement>('[data-geo-value]')!;
  geoBtn?.addEventListener('click', () => {
    if (!navigator.geolocation || !geoLabel) return;
    geoLabel.textContent = 'Ubicando…';
    navigator.geolocation.getCurrentPosition(
      ({ coords }) => {
        geoValue.value = `https://maps.google.com/?q=${coords.latitude.toFixed(6)},${coords.longitude.toFixed(6)}`;
        window.dispatchEvent(new CustomEvent('llevo:geo', { detail: { lat: coords.latitude, lng: coords.longitude } }));
        geoLabel.textContent = 'Ubicación agregada';
        toast.success('Ubicación agregada', { description: 'La usaremos como referencia para la recogida.' });
      },
      () => {
        geoLabel.textContent = 'Usar mi ubicación';
        toast.error('No pudimos obtener tu ubicación', { description: 'Revisa los permisos del navegador o escribe la dirección.' });
      },
      { enableHighAccuracy: true, timeout: 10000 },
    );
  });

  /* ---------- Fotos ---------- */
  const fileInput = form.querySelector<HTMLInputElement>('[data-file-input]')!;
  const dropzone = form.querySelector<HTMLElement>('[data-dropzone]')!;
  const previews = form.querySelector<HTMLUListElement>('[data-previews]')!;

  async function compress(file: File): Promise<File> {
    if (!file.type.startsWith('image/') || file.type === 'image/gif') return file;
    try {
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, MAX_DIM / Math.max(bmp.width, bmp.height));
      if (scale === 1 && file.size < 900_000) return file;
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bmp.width * scale);
      canvas.height = Math.round(bmp.height * scale);
      canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob | null>((r) => canvas.toBlob(r, 'image/jpeg', 0.82));
      if (!blob) return file;
      return new File([blob], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' });
    } catch {
      return file;
    }
  }

  /** Miniatura cuadrada (240 px) de la primera foto, para las listas del panel. */
  async function thumbnail(file: File): Promise<Blob | null> {
    try {
      const bmp = await createImageBitmap(file);
      const S = 240;
      const c = document.createElement('canvas');
      c.width = c.height = S;
      const k = Math.max(S / bmp.width, S / bmp.height);
      const w = bmp.width * k, h = bmp.height * k;
      c.getContext('2d')!.drawImage(bmp, (S - w) / 2, (S - h) / 2, w, h);
      return await new Promise<Blob | null>((r) => c.toBlob(r, 'image/jpeg', 0.75));
    } catch {
      return null;
    }
  }

  async function addFiles(list: FileList | File[]) {
    const incoming = [...list].filter((f) => f.type.startsWith('image/'));
    const room = MAX_FILES - photos.length;
    if (incoming.length > room) {
      toast.warning(`Máximo ${MAX_FILES} fotos`, { description: `Agregamos ${Math.max(0, room)} y dejamos por fuera ${incoming.length - Math.max(0, room)}.` });
    }
    const processed = await Promise.all(incoming.slice(0, Math.max(0, room)).map(compress));
    photos = [...photos, ...processed];
    renderPreviews();
  }

  function renderPreviews() {
    previews.querySelectorAll('img').forEach((img) => URL.revokeObjectURL(img.src));
    previews.innerHTML = '';
    photos.forEach((file, i) => {
      const li = document.createElement('li');
      li.className = 'group relative aspect-square overflow-hidden rounded-2xl bg-sand border border-line';
      const img = document.createElement('img');
      img.src = URL.createObjectURL(file);
      img.alt = `Foto ${i + 1}`;
      img.className = 'size-full object-cover';
      const rm = document.createElement('button');
      rm.type = 'button';
      rm.setAttribute('aria-label', `Quitar foto ${i + 1}`);
      rm.className = 'absolute top-1.5 right-1.5 grid size-7 place-items-center rounded-full bg-ink/80 text-white backdrop-blur transition hover:bg-ink';
      rm.innerHTML = '<svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>';
      rm.addEventListener('click', () => {
        photos.splice(i, 1);
        renderPreviews();
      });
      li.append(img, rm);
      previews.append(li);
    });
  }

  fileInput.addEventListener('change', () => {
    if (fileInput.files) addFiles(fileInput.files);
    fileInput.value = '';
  });
  ['dragenter', 'dragover'].forEach((ev) =>
    dropzone.addEventListener(ev, (e) => {
      e.preventDefault();
      dropzone.dataset.drag = 'true';
    }),
  );
  ['dragleave', 'drop'].forEach((ev) =>
    dropzone.addEventListener(ev, (e) => {
      e.preventDefault();
      dropzone.dataset.drag = 'false';
    }),
  );
  dropzone.addEventListener('drop', (e) => e.dataTransfer?.files && addFiles(e.dataTransfer.files));

  /* ---------- Envío ---------- */
  function summary(data: FormData) {
    const g = (k: string) => String(data.get(k) ?? '').trim();
    const all = (k: string) => data.getAll(k).map(String).filter(Boolean);
    const piso = (p: string) => `${g(`${p}_piso`)}${g(`${p}_piso`) === 'Primer piso' ? '' : ` · ascensor: ${g(`${p}_ascensor`)}`}`;
    const lines = [
      `*Nueva solicitud de ${g('servicio')}* 🚚`,
      '',
      `👤 ${g('nombre')} · ${g('telefono')}${g('email') ? ` · ${g('email')}` : ''}`,
      `📦 ${g('tamano')}`,
      `📍 Recogida: ${g('origen_direccion')}${g('origen_referencia') ? ` (${g('origen_referencia')})` : ''} — ${piso('origen')}`,
      g('origen_ubicacion') ? `   ${g('origen_ubicacion')}` : '',
      `🏁 Entrega: ${g('destino_direccion')}${g('destino_referencia') ? ` (${g('destino_referencia')})` : ''} — ${piso('destino')}`,
      g('destino_ubicacion') ? `   ${g('destino_ubicacion')}` : '',
      `📅 ${g('fecha')} · ${g('franja')}${g('hora') ? ` · ${g('hora')}` : ''}${g('flexible') ? ' (flexible)' : ''}`,
      '',
      `📝 ${g('descripcion')}`,
      all('objetos').length ? `Incluye: ${all('objetos').join(', ')}` : '',
      `Ayuda extra: ${g('ayudantes')}${all('extras').length ? ` · ${all('extras').join(', ')}` : ''}`,
      g('notas') ? `Notas: ${g('notas')}` : '',
      photos.length ? `📷 ${photos.length} foto(s)` : '',
    ];
    return lines.filter((l, i, arr) => l !== '' || arr[i - 1] !== '').join('\n');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    for (let i = 0; i < stepsEls.length; i++) {
      if (!validateStep(i)) {
        if (i !== current) {
          goTo(i);
          setTimeout(() => validateStep(i), 50);
        }
        return;
      }
    }

    const data = new FormData(form);
    if (data.get('_gotcha')) return;
    const text = summary(data);
    const waNumber = form.dataset.whatsapp!;
    const successText = success.querySelector<HTMLElement>('[data-success-text]')!;
    const successWa = success.querySelector<HTMLAnchorElement>('[data-success-wa]')!;
    const codeWrap = success.querySelector<HTMLElement>('[data-success-code-wrap]')!;
    const codeEl = success.querySelector<HTMLElement>('[data-success-code]')!;

    formError.classList.add('hidden');
    submitBtn.disabled = true;
    submitLabel.textContent = 'Enviando…';

    try {
      if (form.dataset.api) {
        data.set('fotos_tipos', JSON.stringify(photos.map((p) => p.type || 'image/jpeg')));
        const res = await fetch('/api/solicitudes', { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const json = (await res.json().catch(() => ({}))) as { code?: string; uploads?: string[]; thumb?: string | null; error?: string };
        if (!res.ok || !json.code) throw new Error(json.error || 'No pudimos enviar tu solicitud.');

        const uploads = json.uploads ?? [];
        let failed = 0;
        for (let i = 0; i < uploads.length; i++) {
          submitLabel.textContent = `Subiendo fotos ${i + 1}/${uploads.length}…`;
          const body = new FormData();
          body.append('cacheControl', '3600');
          body.append('', photos[i]);
          const up = await fetch(uploads[i], { method: 'PUT', body }).catch(() => null);
          if (!up?.ok) failed++;
        }
        if (json.thumb && photos[0]) {
          const t = await thumbnail(photos[0]);
          if (t) {
            const body = new FormData();
            body.append('cacheControl', '3600');
            body.append('', new File([t], 'miniatura.jpg', { type: 'image/jpeg' }));
            await fetch(json.thumb, { method: 'PUT', body }).catch(() => null); // si falla, el panel usa la primera foto
          }
        }

        codeEl.textContent = json.code;
        codeWrap.classList.remove('hidden');
        successText.textContent = failed
          ? `Recibimos tu solicitud, pero ${failed} foto(s) no se pudieron subir. Envíalas por WhatsApp citando tu código.`
          : 'Reviso tus fotos y te escribo la cotización muy pronto por WhatsApp.';
        successWa.href = `https://api.whatsapp.com/send?phone=${waNumber}&text=${encodeURIComponent(`¡Hola! Acabo de enviar la solicitud ${json.code} desde la web.`)}`;
      } else {
        const msg = photos.length ? `${text}\n\n(Te envío las fotos a continuación)` : text;
        successWa.href = `https://api.whatsapp.com/send?phone=${waNumber}&text=${encodeURIComponent(msg)}`;
        successText.textContent = photos.length
          ? 'Abrimos WhatsApp con tu solicitud lista. Envía el mensaje y adjunta tus fotos en el chat.'
          : 'Abrimos WhatsApp con tu solicitud lista. Solo tienes que enviar el mensaje.';
        window.open(successWa.href, '_blank', 'noopener');
      }
      chimeSuccess();
      // Sin toast: la pantalla de éxito ya lo dice (y en el celular el aviso tapaba la animación)
      form.classList.add('hidden');
      document.querySelector('[data-stepper]')?.closest('aside')?.classList.add('lg:hidden');
      formCard.classList.add('lg:col-span-2', 'lg:mx-auto', 'lg:w-full', 'lg:max-w-3xl');
      mobileProgress.classList.add('hidden');
      success.classList.remove('hidden');
      // El formulario largo se oculta y la página se acorta: llevar la vista a la tarjeta de éxito
      window.scrollTo({ top: formCard.getBoundingClientRect().top + window.scrollY - 90, behavior: reduceMotion() ? 'auto' : 'smooth' });
      arrive();
      if (!reduceMotion()) {
        gsap.from(success.firstElementChild, { autoAlpha: 0, duration: 0.3 });
        gsap.from(Array.from(success.children).slice(1), { autoAlpha: 0, y: 10, stagger: 0.06, delay: 0.1, duration: 0.4, ease: 'power3.out' });
      }
    } catch (err) {
      const message = (err instanceof Error && err.message) || 'Intenta de nuevo o escríbeme por WhatsApp.';
      formError.textContent = message;
      formError.classList.remove('hidden');
      toast.error('No pudimos enviar tu solicitud', { description: message });
    } finally {
      submitBtn.disabled = false;
      submitLabel.textContent = 'Enviar solicitud';
    }
  });

  success.querySelector('[data-reset]')?.addEventListener('click', () => {
    form.reset();
    photos = [];
    renderPreviews();
    applyDate();
    updateEstimate();
    codeWrap0.classList.add('hidden');
    geoValue.value = '';
    if (geoLabel) geoLabel.textContent = 'Usar mi ubicación';
    current = 0;
    maxReached = 0;
    form.classList.remove('hidden');
    success.classList.add('hidden');
    document.querySelector('[data-stepper]')?.closest('aside')?.classList.remove('lg:hidden');
    formCard.classList.remove('lg:col-span-2', 'lg:mx-auto', 'lg:w-full', 'lg:max-w-3xl');
    mobileProgress.classList.remove('hidden');
    render();
  });

  const codeWrap0 = success.querySelector<HTMLElement>('[data-success-code-wrap]')!;
  applyDate();
  render();
</script>

