---
/**
 * El momento de la portada: un costado de caja de cartón con la guía de despacho
 * pegada con cinta. Muestra lo que produce el servicio (ruta, carga, fecha y precio).
 */
const items = [
  { name: 'Nevera mediana', qty: 1 },
  { name: 'Cama doble desarmada', qty: 1 },
  { name: 'Escritorio', qty: 1 },
  { name: 'Cajas medianas', qty: 8 },
];
// Código de barras con anchos fijos (determinista para que no cambie entre renders).
const bars = [2, 1, 1, 3, 1, 2, 1, 1, 2, 3, 1, 1, 2, 1, 3, 1, 2, 2, 1, 1, 3, 1, 1, 2, 1, 2, 3, 1, 1, 2, 1, 1, 3, 2, 1, 2, 1, 1, 2, 3];
---

<div class="relative" aria-label="Ejemplo de guía de despacho de un trasteo" role="img" data-guide>
  <!-- Costado de la caja -->
  <div
    class="relative overflow-hidden rounded-[20px] bg-kraft px-4 pt-11 pb-6 shadow-[0_1px_2px_rgba(20,33,61,0.06),0_12px_32px_rgba(20,33,61,0.10)] sm:px-12 sm:pt-16 sm:pb-12"
    style="background-image: linear-gradient(180deg, #d4bc96 0%, #dcc6a2 22%, #dfcaa7 60%, #d6bf9a 100%)"
  >
    <!-- Pliegue de la solapa -->
    <div class="absolute inset-x-0 top-8 h-px bg-[#b89a70]/60" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-[33px] h-px bg-white/25" aria-hidden="true"></div>
    <!-- Cinta de embalar sobre el pliegue -->
    <div data-guide-tape class="absolute top-3 left-1/2 h-12 w-36 -translate-x-1/2 bg-butter/70 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.18)]" aria-hidden="true"></div>

    <!-- Etiqueta (guía) -->
    <div data-guide-label class="relative mx-auto max-w-[420px] -rotate-[1.5deg] rounded-md bg-paper px-5 pt-5 pb-4 sm:px-6 sm:pt-6 sm:pb-5 shadow-[0_1px_2px_rgba(20,33,61,0.10),0_8px_20px_rgba(20,33,61,0.10)]">
      <!-- Cinta en las esquinas -->
      <span data-guide-tape class="absolute -top-3 -left-4 h-6 w-16 -rotate-[28deg] bg-butter/75" aria-hidden="true"></span>
      <span data-guide-tape class="absolute -right-4 -bottom-3 h-6 w-16 -rotate-[28deg] bg-butter/75" aria-hidden="true"></span>

      <div class="flex items-baseline justify-between gap-4">
        <p class="text-[13px] text-ink-2">Guía de despacho</p>
        <p class="font-mono text-xs text-ink-3 tabular-nums">N.º 0142</p>
      </div>
      <p class="mt-1 text-xl font-medium tracking-[-0.01em]">Trasteo de apartamento</p>

      <!-- Sello -->
      <span
        data-guide-stamp
        class="absolute top-[104px] right-6 hidden sm:block rounded-md border-2 border-brand-500/80 px-2 py-0.5 text-[13px] font-semibold text-brand-500/90"
        aria-hidden="true">Agendado</span
      >

      <!-- Ruta (firma) -->
      <div class="mt-5 grid grid-cols-[16px_1fr] gap-x-3">
        <div class="flex flex-col items-center pt-1.5">
          <span class="size-2.5 rounded-full border-2 border-ink bg-paper"></span>
          <span class="route-line my-1" data-guide-route></span>
          <svg viewBox="0 0 12 14" class="h-3.5 w-3 text-brand-500" fill="currentColor" aria-hidden="true"><path d="M1 0h1.5v14H1zM2.5 1h8.5l-2 3 2 3H2.5z"></path></svg>
        </div>
        <div class="space-y-4">
          <div>
            <p class="text-[15px] leading-5 font-medium">Calle 45 #12-30, apto 502</p>
            <p class="text-[13px] text-ink-3">Piso 5 · con ascensor</p>
          </div>
          <div>
            <p class="text-[15px] leading-5 font-medium">Carrera 70 #33-15, casa</p>
            <p class="text-[13px] text-ink-3">Primer piso</p>
          </div>
        </div>
      </div>

      <!-- Perforación -->
      <div class="my-4 border-t border-dashed border-line-strong sm:my-5"></div>

      <ul class="space-y-1.5 font-mono text-[13px] text-ink-2">
        {
          items.map((it, i) => (
            <li class:list={['justify-between gap-4', i < 2 ? 'flex' : 'hidden sm:flex']} data-guide-item>
              <span>{it.name}</span>
              <span class="tabular-nums">{it.qty}</span>
            </li>
          ))
        }
      </ul>

      <div class="my-4 border-t border-dashed border-line-strong sm:my-5"></div>

      <div class="flex items-end justify-between gap-4">
        <dl class="grid grid-cols-2 gap-x-5 gap-y-1 text-[13px] whitespace-nowrap">
          <dt class="text-ink-3">Fecha</dt>
          <dt class="text-ink-3">Hora</dt>
          <dd class="font-medium">Sáb 14 nov</dd>
          <dd class="font-medium tabular-nums">8:00 a. m.</dd>
        </dl>
        <div class="text-right">
          <p class="text-[13px] text-ink-3">Total</p>
          <p class="font-mono text-2xl font-medium tracking-[-0.02em] tabular-nums" data-guide-total data-value="185000">$185.000</p>
        </div>
      </div>

      <!-- Código de barras -->
      <div class="mt-5 hidden h-9 items-stretch gap-[2px] sm:flex" aria-hidden="true">
        {bars.map((w) => <span class="bg-ink" style={`width:${w}px`} />)}
      </div>
      <p class="mt-1 hidden font-mono text-[11px] tracking-[0.12em] text-ink-3 sm:block" aria-hidden="true">LLV 0142 1411</p>
    </div>
  </div>
</div>
