---
import { Icon } from 'astro-icon/components';
import { cityName, whatsappLink, type Business } from '../lib/settings';
import DispatchLabel from './DispatchLabel.astro';

const { business } = Astro.props as { business: Business };
---

<section class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-12 pb-20 sm:px-6 lg:min-h-[calc(100dvh-64px)] lg:grid-cols-[1fr_1.05fr] lg:gap-16 lg:py-16">
  <div>
    <p class="flex items-center gap-2 text-sm text-ink-2" data-hero-fade>
      <span class="size-2 rounded-full bg-[#16a34a]" aria-hidden="true"></span>
      {business.heroBadge} en {cityName(business)} · Respuesta en minutos
    </p>

    <h1 data-hero-title class="mt-6 font-display text-[40px] leading-[1.05] font-semibold tracking-[-0.03em] text-balance sm:text-6xl lg:text-[68px]">
      Tú lo empacas, nosotros lo llevamos
    </h1>

    <p data-hero-fade class="mt-6 max-w-[36rem] text-lg leading-[1.6] text-pretty text-ink-2 sm:text-[19px]">
      Trasteos, mudanzas pequeñas y acarreos en {cityName(business)}. Sube fotos de lo que vas a mover, elige día y hora, y te
      enviamos el precio por WhatsApp.
    </p>

    <div data-hero-fade class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a href="#cotizar" class="btn-primary h-12 px-6 text-base">
        Cotizar mi trasteo
        <Icon name="heroicons:arrow-right" class="size-[18px]" />
      </a>
      <a href={whatsappLink(business.whatsapp)} target="_blank" rel="noopener" class="btn-ghost h-12 px-6 text-base">
        Escribir por WhatsApp
      </a>
    </div>
  </div>

  <DispatchLabel />
</section>
