---
import { Icon } from 'astro-icon/components';
import { whatsappLink, type Business } from '../lib/settings';

const { business } = Astro.props as { business: Business };
---

<section class="relative overflow-hidden">
  <!-- fondo decorativo -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-40 -right-32 size-[520px] rounded-full bg-brand-200/50 blur-3xl"></div>
    <div class="absolute top-60 -left-40 size-[420px] rounded-full bg-amber-100/70 blur-3xl"></div>
    <div
      class="absolute inset-0 opacity-[0.35] [background-image:radial-gradient(#d6d3d1_1px,transparent_1px)] [background-size:22px_22px] [mask-image:linear-gradient(to_bottom,black,transparent_75%)]"
    >
    </div>
  </div>

  <div class="mx-auto grid max-w-6xl items-center gap-14 px-4 pt-12 pb-20 sm:px-6 lg:grid-cols-[1.1fr_1fr] [&>*]:min-w-0 lg:pt-20 lg:pb-28">
    <div>
      <span class="section-eyebrow">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand-500 opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-brand-500"></span>
        </span>
        {business.heroBadge}
      </span>

      <h1 class="mt-6 font-display text-[2.6rem] leading-[1.04] font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        Tú lo empacas,{' '}
        <span class="relative whitespace-nowrap text-brand-500">
          nosotros
          <svg class="absolute -bottom-1 left-0 w-full text-brand-300 sm:-bottom-2" viewBox="0 0 200 12" fill="none" aria-hidden="true">
            <path d="M2 9c40-6 120-8 196-3" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
          </svg>
        </span>{' '}
        lo llevamos.
      </h1>

      <p class="mt-6 max-w-xl text-lg text-pretty text-stone-600">
        Trasteos, mudanzas pequeñas y acarreos de un lugar a otro. Sube fotos de lo que vas a mover, elige día y hora,
        y te enviamos el precio por WhatsApp.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#cotizar" class="btn-primary !px-7 !py-4 !text-base">
          Cotizar mi trasteo
          <Icon name="heroicons:arrow-right" class="size-5" />
        </a>
        <a href={whatsappLink(business.whatsapp)} target="_blank" rel="noopener" class="btn-ghost !px-7 !py-4 !text-base">
          <Icon name="heroicons:chat-bubble-left-right" class="size-5" />
          Escríbenos
        </a>
      </div>

      <ul class="mt-10 grid max-w-lg grid-cols-3 gap-4 text-sm">
        {
          [
            { icon: 'heroicons:bolt', title: 'Respuesta', text: 'en minutos' },
            { icon: 'heroicons:shield-check', title: 'Carga', text: 'protegida' },
            { icon: 'heroicons:banknotes', title: 'Precio', text: 'sin sorpresas' },
          ].map((f) => (
            <li class="flex flex-col gap-2">
              <span class="grid size-10 place-items-center rounded-xl bg-white text-brand-600 shadow-sm ring-1 ring-stone-200">
                <Icon name={f.icon} class="size-5" />
              </span>
              <span>
                <span class="block font-semibold">{f.title}</span>
                <span class="text-stone-500">{f.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Tarjeta ilustrativa de una solicitud -->
    <div class="relative mx-auto mb-8 w-full max-w-md lg:max-w-none" aria-hidden="true">
      <div class="animate-float rounded-[2rem] bg-white p-6 shadow-2xl ring-1 shadow-stone-900/10 ring-stone-200/80 sm:p-7">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-medium tracking-wide text-stone-400 uppercase">Solicitud</p>
            <p class="font-display text-xl font-bold">Trasteo de apartamento</p>
          </div>
          <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200">Confirmado</span>
        </div>

        <div class="mt-6 grid grid-cols-[auto_1fr] gap-x-4">
          <div class="flex flex-col items-center">
            <span class="grid size-8 place-items-center rounded-full bg-brand-100 text-brand-600">
              <Icon name="heroicons:map-pin-solid" class="size-4" />
            </span>
            <span class="my-1 w-px flex-1 border-l-2 border-dashed border-stone-200"></span>
            <span class="grid size-8 place-items-center rounded-full bg-ink text-white">
              <Icon name="heroicons:flag-solid" class="size-4" />
            </span>
          </div>
          <div class="space-y-5">
            <div>
              <p class="text-xs text-stone-400">Recogida</p>
              <p class="font-medium">Calle 45 #12-30, Apto 502</p>
              <p class="text-xs text-stone-500">Piso 5 · con ascensor</p>
            </div>
            <div>
              <p class="text-xs text-stone-400">Entrega</p>
              <p class="font-medium">Carrera 70 #33-15, Casa</p>
              <p class="text-xs text-stone-500">Primer piso</p>
            </div>
          </div>
        </div>

        <div class="mt-6 grid grid-cols-4 gap-2">
          {
            ['heroicons:archive-box', 'heroicons:tv', 'heroicons:computer-desktop', 'heroicons:cube'].map((i) => (
              <div class="grid aspect-square place-items-center rounded-2xl bg-sand text-stone-500">
                <Icon name={i} class="size-6" />
              </div>
            ))
          }
        </div>

        <div class="mt-6 flex flex-wrap gap-2 text-sm">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-sand px-3 py-1.5 font-medium">
            <Icon name="heroicons:calendar-days" class="size-4 text-stone-500" /> Sáb 14
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-sand px-3 py-1.5 font-medium">
            <Icon name="heroicons:clock" class="size-4 text-stone-500" /> 8:00 a.m.
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-sand px-3 py-1.5 font-medium">
            <Icon name="heroicons:user-group" class="size-4 text-stone-500" /> +1 ayudante
          </span>
        </div>
      </div>

      <!-- etiqueta flotante -->
      <div class="absolute -bottom-12 -left-2 flex items-center gap-3 rounded-2xl bg-ink px-4 py-3 text-white shadow-xl sm:-left-8">
        <span class="grid size-10 place-items-center rounded-xl bg-brand-500">
          <Icon name="heroicons:truck" class="size-5 animate-drive" />
        </span>
        <div>
          <p class="text-xs text-stone-400">En camino</p>
          <p class="text-sm font-semibold">Llegamos en 25 min</p>
        </div>
      </div>
    </div>
  </div>
</section>
