---
import { STATUSES, type Status } from '../../lib/constants';

const { status } = Astro.props as { status: Status };
const s = STATUSES[status] ?? STATUSES.nueva;
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ring-1 whitespace-nowrap', s.badge]}>
  <span class:list={['size-1.5 rounded-full', s.dot]}></span>
  {s.label}
</span>
