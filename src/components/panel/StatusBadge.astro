---
import { Icon } from 'astro-icon/components';
import { STATUSES, type Status } from '../../lib/constants';

const { status, ...rest } = Astro.props as { status: Status } & Record<string, unknown>;
const s = STATUSES[status] ?? STATUSES.nueva;
---

<span {...rest} class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ring-1 whitespace-nowrap', s.badge]}>
  <Icon name={s.icon} class="size-3.5" />
  {s.label}
</span>
