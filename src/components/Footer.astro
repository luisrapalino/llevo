---
import { Icon } from 'astro-icon/components';
import { whatsappLink, type Business } from '../lib/settings';
import Logo from './Logo.astro';

const { business: site } = Astro.props as { business: Business };
---

<footer class="px-4 pb-6 sm:px-6">
  <div class="mx-auto max-w-6xl overflow-hidden rounded-[20px] bg-ink text-[#f2f5ff]">
    <div class="grid gap-8 p-8 sm:p-12 lg:grid-cols-[1.5fr_1fr] lg:items-center" data-reveal>
      <div>
        <h2 class="text-3xl font-medium tracking-[-0.02em] text-balance sm:text-4xl">¿Listo para mover tus cosas? Cotiza gratis</h2>
        <p class="mt-3 text-[#b4bdd4]">Sin compromiso. Respuesta en minutos.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
        <a href="#cotizar" class="btn-primary h-12 px-6">Cotizar ahora <Icon name="heroicons:arrow-right" class="size-4" /></a>
        <a href={whatsappLink(site.whatsapp)} target="_blank" rel="noopener" class="btn h-12 border border-white/15 px-6 text-[#f2f5ff] hover:bg-white/5">
          WhatsApp
        </a>
      </div>
    </div>

    <div class="grid gap-8 border-t border-white/10 p-8 text-sm sm:grid-cols-3 sm:p-12">
      <div>
        <Logo height={38} variant="inverso" />
        <p class="mt-3 text-[#b4bdd4]">{site.tagline}</p>
      </div>
      <ul class="space-y-3 text-[#b4bdd4]">
        <li class="flex items-center gap-2.5"><Icon name="heroicons:phone" class="size-4 text-[#8c96b0]" /> {site.phoneDisplay}</li>
        <li class="flex items-center gap-2.5"><Icon name="heroicons:envelope" class="size-4 text-[#8c96b0]" /> {site.email}</li>
        <li class="flex items-center gap-2.5"><Icon name="heroicons:map-pin" class="size-4 text-[#8c96b0]" /> {site.city}</li>
      </ul>
      <ul class="space-y-3 text-[#b4bdd4]">
        <li class="flex items-center gap-2.5"><Icon name="heroicons:clock" class="size-4 text-[#8c96b0]" /> {site.hours}</li>
        <li>
          <button type="button" data-install class="hidden items-center gap-2 font-semibold text-white transition-colors hover:text-butter [&:not(.hidden)]:inline-flex">
            <Icon name="heroicons:device-phone-mobile" class="size-4 text-butter" /> Instalar la app
          </button>
        </li>
        <li class="text-[#8c96b0]">© {new Date().getFullYear()} {site.name}</li>
      </ul>
    </div>
  </div>
</footer>
