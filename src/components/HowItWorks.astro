---
const steps = [
  {
    title: 'Cuéntanos qué llevas',
    text: 'Llena el formulario y sube fotos de tus cosas. Así calculamos espacio y esfuerzo sin adivinar.',
  },
  {
    title: 'Recibe tu precio',
    text: 'Te escribimos por WhatsApp con la cotización final antes de confirmar el servicio.',
  },
  {
    title: 'Nosotros lo llevamos',
    text: 'Llegamos el día y la hora acordados, cargamos con cuidado y entregamos en destino.',
  },
];
---

<section id="como-funciona" class="scroll-mt-20 bg-ink py-20 text-[#f2f5ff] sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="text-sm font-medium text-brand-300">Cómo funciona</p>
        <h2 class="section-title mt-3">Tres pasos y listo</h2>
      </div>
      <p class="text-[#b4bdd4]">Cotizar te toma menos de 2 minutos desde tu celular.</p>
    </div>

    <ol class="relative mt-8 grid gap-0 md:mt-14 md:grid-cols-3 md:gap-8" data-steps>
      <span class="absolute top-0 left-0 hidden h-px w-full origin-left bg-brand-400 md:block" aria-hidden="true" data-steps-line></span>
      {
        steps.map((s, i) => (
          <li class="grid grid-cols-[2.25rem_1fr] gap-x-3 border-t border-white/10 py-4 md:block md:pt-6 md:pb-0" data-reveal>
            <span class="row-span-2 grid size-9 place-items-center rounded-full bg-white/10 font-mono text-sm text-[#c8d0e4] tabular-nums md:inline md:size-auto md:rounded-none md:bg-transparent md:text-[#8c96b0]">0{i + 1}</span>
            <h3 class="self-center text-base font-medium md:mt-4 md:text-lg">{s.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-[#b4bdd4] md:mt-2 md:text-[15px]">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
