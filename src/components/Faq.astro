---
import { Icon } from 'astro-icon/components';
import type { Faq } from '../lib/settings';

const { faqs } = Astro.props as { faqs: Faq[] };
---

<section id="faq" class="scroll-mt-20 border-t border-line py-14 sm:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_1.4fr]">
    <div data-reveal>
      <p class="section-eyebrow">Preguntas frecuentes</p>
      <h2 class="section-title mt-3">Antes de reservar</h2>
      <p class="mt-4 max-w-sm text-ink-2">Si no encuentras tu respuesta, escríbeme por WhatsApp.</p>
      <img
        src="/illustrations/faq-mark.png"
        alt=""
        width="616"
        height="710"
        class="scene mt-8 h-auto w-full max-w-[13rem]"
      />
    </div>

    <div class="divide-y divide-line border-y border-line">
      {
        faqs.map((f) => (
          <details data-reveal class="group py-5 [&_summary::-webkit-details-marker]:hidden" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
              {f.q}
              <Icon name="heroicons:plus" class="size-[18px] shrink-0 text-ink-3 transition-transform duration-200 group-open:rotate-45" />
            </summary>
            <p class="mt-3 pr-10 text-[15px] leading-relaxed text-ink-2">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
