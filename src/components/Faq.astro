---
import { Icon } from 'astro-icon/components';

import type { Faq } from '../lib/settings';

const { faqs } = Astro.props as { faqs: Faq[] };
---

<section id="faq" class="scroll-mt-20 py-20 sm:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_1.4fr]">
    <div>
      <span class="section-eyebrow">Preguntas frecuentes</span>
      <h2 class="section-title mt-4">¿Tienes dudas?</h2>
      <p class="mt-4 text-stone-600">Si no encuentras tu respuesta, escríbenos por WhatsApp y te respondemos al momento.</p>
    </div>

    <div class="divide-y divide-stone-200 rounded-3xl bg-white px-6 ring-1 ring-stone-200/80">
      {
        faqs.map((f) => (
          <details class="group py-5 [&_summary::-webkit-details-marker]:hidden" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
              {f.q}
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-sand transition group-open:rotate-45 group-open:bg-brand-500 group-open:text-white">
                <Icon name="heroicons:plus" class="size-4" />
              </span>
            </summary>
            <p class="mt-3 pr-10 text-sm leading-relaxed text-stone-600">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
